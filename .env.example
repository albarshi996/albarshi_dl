# ═══════════════════════════════════════════════════════════════════════
# Dawerli Platform — Environment Variables Template
# ═══════════════════════════════════════════════════════════════════════
#
# SETUP INSTRUCTIONS:
#   1. Copy this file → rename to ".env"  (git will ignore it — see .gitignore)
#   2. Fill in the values below.
#   3. GitHub Pages builds (deploy.yml) do NOT read .env — see each section.
#
# ⚠️  NEVER commit ".env" — it may contain real credentials
# ═══════════════════════════════════════════════════════════════════════

# ─── Supabase (قاعدة البيانات · Auth · Storage) ──────────────────────
# للتطوير المحلي فقط: القيم من خرج `npx supabase status` بعد `npx supabase start`
# (انظر docs/SUPABASE-SETUP.md قسم «التطوير المحلي»).
# للنشر على GitHub Pages لا تُقرأ هذه القيم — الصق Project URL و anon key
# مباشرة في src/lib/supabase-config.js واعتمد الملف.
# المفتاح anon عام بطبيعته (الحماية في سياسات RLS داخل القاعدة).
# ⛔ لا تضع مفتاح service_role هنا ولا في أي ملف في المستودع.
# NOTE: PUBLIC_ prefix is REQUIRED — Astro only exposes PUBLIC_* to browser JS
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# ─── Moamalat (بوابة الدفع — Sandbox) ────────────────────────────────
# Read at build time by src/pages/checkout.astro (import.meta.env).
# MID/TID below are Moamalat's PUBLIC sandbox test identifiers (safe demo fallbacks).
# ⛔ MOAMALAT_SECRET_KEY must never be committed or shipped to the browser;
#    real payments need the SecureHash computed on a server, not here.
MOAMALAT_MERCHANT_ID=10081014740
MOAMALAT_TERMINAL_ID=99881350
MOAMALAT_SECRET_KEY=
MOAMALAT_ENV=sandbox
MOAMALAT_CURRENCY=434
MOAMALAT_SANDBOX_URL=https://demo.moamalat.net
