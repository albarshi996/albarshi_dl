---
// src/components/Header.astro
// ✅ CHANGE: أُضيف رابط "وين طلبي؟" في القائمة الرئيسية
const pathname = new URL(Astro.request.url).pathname;
const currentPath = pathname.slice(1);
---

<header>
  <a href="/" class="logo" aria-label="الصفحة الرئيسية - دورلي">
    <svg class="logo-mark" width="34" height="34" viewBox="0 0 48 48" aria-hidden="true">
      <defs>
        <linearGradient id="dwLogo" x1="4" y1="4" x2="44" y2="44" gradientUnits="userSpaceOnUse">
          <stop stop-color="#F5A524"/><stop offset=".55" stop-color="#F27B35"/><stop offset="1" stop-color="#D95B43"/>
        </linearGradient>
      </defs>
      <rect x="3" y="3" width="42" height="42" rx="12.5" fill="url(#dwLogo)"/>
      <path d="M15 17 C 23 13 26 27 33 29" fill="none" stroke="#fff" stroke-width="2.4" stroke-linecap="round" opacity=".85"/>
      <circle cx="15" cy="17" r="3.4" fill="#fff"/>
      <path d="M32.5 21.5c-3.6 0-6.5 2.9-6.5 6.5 0 4.7 6.5 9.5 6.5 9.5s6.5-4.8 6.5-9.5c0-3.6-2.9-6.5-6.5-6.5z" fill="#fff"/>
      <circle cx="32.5" cy="28" r="2.4" fill="url(#dwLogo)"/>
    </svg>
    <span class="logo-word">دورلي</span>
  </a>

  <div class="header-actions">
    <button id="langToggleBtn" class="lang-toggle" title="تبديل اللغة">
      <span class="lang-label">ع</span>
    </button>
  </div>

  <nav id="mainNav">
    <a href="/" class={currentPath === "" ? "active" : ""}>
      <i class="fas fa-home"></i> <span data-i18n="home">الرئيسية</span>
    </a>
    <a href="/how-it-works" class={currentPath === "how-it-works" ? "active" : ""}>
      <i class="fas fa-question"></i> <span data-i18n="howItWorks">شن الطريقة</span>
    </a>
    <a href="/features" class={currentPath === "features" ? "active" : ""}>
      <i class="fas fa-gem"></i> <span data-i18n="features">الميزات</span>
    </a>
    <a href="/services" class={currentPath === "services" ? "active" : ""}>
      <i class="fas fa-cogs"></i> <span data-i18n="services">خدماتنا</span>
    </a>
    <!-- ✅ ADDED: رابط تتبع الطلب -->
    <a href="/track" class={currentPath === "track" ? "active" : ""}>
      <i class="fab fa-whatsapp"></i> <span data-i18n="trackOrder">وين طلبي؟</span>
    </a>
    <a href="/contact" class={currentPath === "contact" ? "active" : ""}>
      <i class="fas fa-envelope"></i> <span data-i18n="contact">كلمنا</span>
    </a>
    <a href="/pricing" class={currentPath === "pricing" ? "active" : ""}>
      <i class="fas fa-tags"></i> <span data-i18n="pricing">الباقات</span>
    </a>
    <a href="/request" class="services-btn">
      <i class="fas fa-paper-plane"></i> <span data-i18n="request">اطلب توا</span>
    </a>
  </nav>

  <button id="mobileMenuBtn" class="mobile-menu-btn">
    <i class="fas fa-bars"></i>
  </button>
</header>

<script is:inline>
(function() {
  var LANG_KEY = 'dawerli_lang';

  var dict = {
    ar: {
      dir: 'rtl',
      home: 'الرئيسية', howItWorks: 'شن الطريقة', features: 'الميزات',
      services: 'خدماتنا', contact: 'كلمنا', pricing: 'الباقات',
      request: 'اطلب توا',
      trackOrder: 'وين طلبي؟',
      heroTitle: 'تدوّر على حاجة؟ دورلي يجيبهالك',
      heroDesc: 'قطعة غيار، دواء، فستان، ولا بضاعة لمحلّك — اكتبلنا شن تبي، واحنا ندوّروا ونشروا ونوصّلوا لين باب الحوش.',
      heroOrderBtn: 'اطلب توا', heroServicesBtn: 'شوف الخدمات',
      howTitle: 'شن الطريقة؟', howSub: 'ثلاث خطوات وبس… وطلبك في الطريق',
      howStep1Title: 'ابعت طلبك', howStep1Desc: 'اكتبلنا شن تبي بالتفصيل، في النموذج ولا على الواتساب',
      howStep2Title: 'ندوّروا ونشروا', howStep2Desc: 'فريقنا يدوّر على أحسن سعر وجودة، ويشري عنك',
      howStep3Title: 'نوصّلوا لبابك', howStep3Desc: 'توصيل سريع ومضمون لأي مدينة في ليبيا',
      howHeroTitle: 'شن الطريقة؟',
      howHeroDesc: 'أربع خطوات بس تفصلك على اللي تبيه.',
      hiwStep1Title: 'قولنا شن تبي', hiwStep1Desc: 'عبّي نموذج الطلب ولا كلمنا على الواتساب.',
      hiwStep2Title: 'ندوّروا ونسعّروا', hiwStep2Desc: 'فريقنا يدوّر ويكلمك بالتكلفة الكاملة.',
      hiwStep3Title: 'توافق ونشروا', hiwStep3Desc: 'كان وافقت، نشروا عنك ونجهزوا طلبك.',
      hiwStep4Title: 'يوصلك وتدفع', hiwStep4Desc: 'مندوبنا يوصلك، تتأكد وبعدين تدفع.',
      langLabelShort: 'ع', themeToggleTitle: 'تبديل المظهر', logoAria: 'الصفحة الرئيسية - دورلي',
    },
    en: {
      dir: 'ltr',
      home: 'Home', howItWorks: 'How it works', features: 'Features',
      services: 'Services', contact: 'Contact', pricing: 'Pricing', request: 'Place order',
      trackOrder: 'Track Order',
      heroTitle: 'The connector between you and what you need',
      heroDesc: 'Dawerli finds, buys and delivers from any city in Libya — fast and affordably.',
      heroOrderBtn: 'Place order', heroServicesBtn: 'Browse services',
      howTitle: 'How Dawerli works', howSub: '3 simple steps and your order is on its way',
      howStep1Title: 'Send your request', howStep1Desc: 'Describe what you need via form or WhatsApp',
      howStep2Title: 'We search and buy', howStep2Desc: 'Our team finds the best price and quality',
      howStep3Title: 'We deliver to your door', howStep3Desc: 'Fast delivery to any Libyan city',
      howHeroTitle: 'How Dawerli works',
      howHeroDesc: 'Four simple steps to get what you need from anywhere in Libya.',
      hiwStep1Title: 'Tell us what you need', hiwStep1Desc: 'Fill the order form or contact us via WhatsApp.',
      hiwStep2Title: 'Search & Pricing', hiwStep2Desc: 'We search and contact you with total cost.',
      hiwStep3Title: 'Confirm & Purchase', hiwStep3Desc: 'We purchase on your behalf after approval.',
      hiwStep4Title: 'Receive & Pay', hiwStep4Desc: 'Delivered to your door. Pay on delivery.',
      langLabelShort: 'EN', themeToggleTitle: 'Toggle theme', logoAria: 'Home — Dawerli',
    }
  };

  function applyHeaderLang(lang) {
    var d = dict[lang] || dict['ar'];

    /* Resolve full dictionary: window.dawerliDict (Layout.astro head)
       is the superset. Support both .strings-wrapped and flat formats. */
    var full = {};
    try {
      var wd = window.dawerliDict && window.dawerliDict[lang];
      if (wd) full = (typeof wd.strings === 'object' && wd.strings !== null)
                     ? wd.strings : wd;
    } catch (_) {}

    document.documentElement.lang = lang;
    document.documentElement.dir  = d.dir;

    /* Translate every [data-i18n] element.
       Full dict wins → small dict fallback → leave unchanged. */
    document.querySelectorAll('[data-i18n]').forEach(function(el) {
      var key = el.getAttribute('data-i18n');
      var val = full[key] !== undefined ? full[key] : d[key];
      if (val !== undefined) el.textContent = val;
    });

    /* Translate [data-i18n-placeholder] (form inputs) */
    document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el) {
      var key = el.getAttribute('data-i18n-placeholder');
      var val = full[key] !== undefined ? full[key] : d[key];
      if (val !== undefined) el.setAttribute('placeholder', val);
    });

    /* Update lang-toggle label */
    var label = document.querySelector('.lang-label');
    if (label) {
      label.textContent = full.langLabelShort || d.langLabelShort
                          || (lang === 'ar' ? 'ع' : 'EN');
    }

    try { localStorage.setItem(LANG_KEY, lang); } catch(e) {}
  }

  function getSavedLang() {
    try { return localStorage.getItem(LANG_KEY) || 'ar'; } catch(e) { return 'ar'; }
  }

  applyHeaderLang(getSavedLang());

  document.addEventListener('DOMContentLoaded', function() {
    /* Re-run full translation now that ALL [data-i18n] elements exist in
       the DOM. The earlier inline applyHeaderLang() call only reached
       elements parsed before this script tag (= header elements only).
       This call translates the entire page body on initial load.       */
    try { applyHeaderLang(getSavedLang()); } catch(_) {}

    var btn = document.getElementById('langToggleBtn');
    if (btn) {
      var freshBtn = btn.cloneNode(true);
      btn.parentNode.replaceChild(freshBtn, btn);
      freshBtn.addEventListener('click', function(e) {
        e.preventDefault();
        e.stopPropagation();

        /* ① CRITICAL FIX: freeze nav transitions BEFORE any DOM attribute
           change. applyHeaderLang() sets html[lang] then html[dir], which
           triggers CSS html[lang="en"] nav { right:auto; left:-100% }.
           Without this guard the browser starts a right:-100%→right:auto
           transition making the nav drawer fly visually onto the screen.
           MutationObserver in mobile-nav.js also tries to add this class
           but fires AFTER the CSS engine has already begun the transition.
           Adding it here — synchronously in the click handler — guarantees
           the class is active before ANY reflow happens.                  */
        var navEl = document.getElementById('mainNav');
        if (navEl) navEl.classList.add('no-transition');

        /* ② Toggle language */
        var next = getSavedLang() === 'ar' ? 'en' : 'ar';
        applyHeaderLang(next);

        /* ③ Update document title (lang-specific). applyHeaderLang()
           already translated all [data-i18n] elements in one pass.      */
        try {
          var wd   = window.dawerliDict && window.dawerliDict[next];
          var full = wd ? ((wd.strings && typeof wd.strings === 'object')
                          ? wd.strings : wd) : {};
          var page = document.documentElement.dataset.page || 'index';
          if (full['metaTitle_' + page]) document.title = full['metaTitle_' + page];
        } catch (_) {}

        /* ④ Re-enable transitions only after 2 animation frames:
           frame 1 → browser applies new CSS position (left:-100%)
           frame 2 → browser has painted the settled position
           Only then are smooth transitions restored for user actions.     */
        window.requestAnimationFrame(function() {
          window.requestAnimationFrame(function() {
            if (navEl) navEl.classList.remove('no-transition');
          });
        });
      });
    }
  });
})();
</script>
