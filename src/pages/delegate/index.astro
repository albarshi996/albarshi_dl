---
// بوابة المندوب — الطلبات المتاحة للحجز (view: delegate_open_orders، بلا اسم أو هاتف الزبون حتى الحجز).
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="طلبات متاحة" portal="delegate" page="pool">
  <button slot="actions" type="button" class="btn btn-ghost btn-sm" id="refreshBtn">
    <i class="fas fa-rotate"></i> <span>تحديث</span>
  </button>

  <div class="ptr" id="ptr" aria-hidden="true"><i class="fas fa-arrow-down"></i> <span>اسحب للتحديث</span></div>

  <div class="stats" id="stats" hidden></div>

  <div id="limitNote" class="pool-note warn" hidden>
    <i class="fas fa-triangle-exclamation"></i> عندك 5 طلبات جارية — كمّل واحد منها من <a href="/delegate/mine/">طلباتي</a> قبل ما تحجز طلباً جديداً.
  </div>

  <div class="pool-head">
    <h2>طلبات متاحة في مدينتك والمدن القريبة</h2>
    <p class="muted">احجز الطلب اللي تقدر تدوّره وتوصّله — أول ما تحجزه يظهرلك اسم الزبون ورقمه في صفحة «طلباتي». العاجل يظهر أولاً، ثم الأقدم.</p>
  </div>

  <div id="adminNote" class="pool-note" hidden>
    <i class="fas fa-circle-info"></i> أنت تتصفح كمدير — الحجز متاح للمندوبين فقط، أمّا الإسناد فمن <a href="/admin/orders/?unassigned=1">لوحة الطلبات</a>.
  </div>

  <div class="chips" id="cityChips"></div>

  <div id="list"></div>

  <p class="muted small" id="lastUpdated"></p>
</AdminLayout>

<style is:global>
  body[data-page="pool"] .pool-head h2 { font-size: 1.1rem; color: var(--white); margin-bottom: .25rem; }
  body[data-page="pool"] .pool-head p { font-size: .9rem; }
  body[data-page="pool"] .pool-note {
    display: flex; align-items: center; gap: .6rem; font-size: .88rem; color: var(--muted);
    background: rgba(56,189,248,.08); border: 1px solid rgba(56,189,248,.3); border-radius: var(--r); padding: .7rem .9rem;
  }
  body[data-page="pool"] .pool-note i { color: var(--info); }
  body[data-page="pool"] .pool-note.warn { background: rgba(250,204,21,.09); border-color: rgba(250,204,21,.35); color: var(--text); }
  body[data-page="pool"] .pool-note.warn i { color: #FDE68A; }
  body[data-page="pool"] .stat-link { display: block; color: inherit; border-radius: var(--r-lg); transition: transform var(--dur) var(--ease); }
  body[data-page="pool"] .stat-link .stat { height: 100%; }
  body[data-page="pool"] .stat-link:hover { transform: translateY(-2px); }
  body[data-page="pool"] .small { font-size: .8rem; text-align: center; }
  body[data-page="pool"] .chip .n { opacity: .75; font-size: .75rem; margin-right: .2rem; }
  body[data-page="pool"] .chip .fa-house { font-size: .7rem; margin-left: .25rem; }
  body[data-page="pool"] .order-card.is-urgent { border-color: rgba(239,68,68,.4); }
  body[data-page="pool"] .badge.badge-urgent { background: rgba(239,68,68,.16); color: #FCA5A5; border-color: rgba(239,68,68,.4); }
  body[data-page="pool"] .badge.badge-mid { background: rgba(250,204,21,.12); color: #FDE68A; border-color: rgba(250,204,21,.35); }
  body[data-page="pool"] .oc-meta i { color: var(--muted-2); margin-left: .2rem; }
  body[data-page="pool"] .oc-details { cursor: pointer; position: relative; }
  body[data-page="pool"] .oc-details.expanded { max-height: none; }
  body[data-page="pool"] .oc-part { font-size: .88rem; background: rgba(255,255,255,.03); border: 1px dashed var(--line-2); border-radius: var(--r); padding: .6rem .8rem; }
  body[data-page="pool"] .oc-foot .btn { min-height: 46px; }
  body[data-page="pool"] .ptr {
    position: fixed; top: calc(var(--topbar-h) + .5rem); left: 50%; z-index: 30;
    transform: translate(-50%, -40px); opacity: 0; transition: transform 150ms var(--ease), opacity 150ms;
    background: var(--panel-2); border: 1px solid var(--line-2); border-radius: var(--pill);
    padding: .4rem .9rem; font-size: .82rem; color: var(--muted); display: inline-flex; gap: .4rem; align-items: center; pointer-events: none;
  }
  body[data-page="pool"] .ptr.show { opacity: 1; transform: translate(-50%, 0); }
  body[data-page="pool"] .ptr.ready { color: var(--primary-light); border-color: rgba(245,165,36,.45); }
  body[data-page="pool"] .ptr.ready i { transform: rotate(180deg); }
  body[data-page="pool"] .ptr i { transition: transform 150ms; }
  @media (max-width: 640px) {
    body[data-page="pool"] .order-cards { grid-template-columns: 1fr; }
  }
</style>

<script>
  // @ts-nocheck
  const { db, ui, sb, profile } = await window.dawerliReady;

  if (sb && profile) init();

  function init() {
    const esc = db.esc;
    const listEl = document.getElementById('list');
    const chipsEl = document.getElementById('cityChips');
    const refreshBtn = document.getElementById('refreshBtn');
    const lastUpdated = document.getElementById('lastUpdated');
    const adminNote = document.getElementById('adminNote');
    const limitNote = document.getElementById('limitNote');
    const statsEl = document.getElementById('stats');
    const ptr = document.getElementById('ptr');

    const MAX_ACTIVE = 5; // نفس الحد في claim_order
    const canClaim = profile.role === 'delegate' && profile.active;
    adminNote.hidden = profile.role !== 'admin';

    let orders = [];
    let city = null;          // المدينة المختارة، null = كل المدن
    let cityTouched = false;  // هل اختار المندوب مدينة بنفسه (فلا نغيّرها عند التحديث)
    let loading = false;
    let atLimit = false;      // وصل المندوب لحد الطلبات الجارية

    // ───── إحصائيات المندوب (شريط مختصر) ─────
    async function loadStats() {
      if (!canClaim) { statsEl.hidden = true; return; } // الدالة ترجع null لغير المندوب
      try {
        const s = await db.delegateStats();
        if (!s) { statsEl.hidden = true; return; }
        atLimit = Number(s.active || 0) >= MAX_ACTIVE;
        limitNote.hidden = !atLimit;
        statsEl.hidden = false;
        statsEl.innerHTML = [
          `<a href="/delegate/mine/" class="stat-link" title="طلباتي">${ui.statTile({ label: `طلبات جارية (من ${MAX_ACTIVE})`, value: s.active ?? 0, icon: 'fa-person-running', tone: atLimit ? 'accent' : '' })}</a>`,
          ui.statTile({ label: 'وصلت هذا الشهر', value: s.delivered_month ?? 0, icon: 'fa-circle-check', tone: 'success' }),
          ui.statTile({ label: 'عمولتك هذا الشهر', value: db.formatMoney(s.commission_month), icon: 'fa-coins' }),
        ].join('');
      } catch (e) {
        statsEl.hidden = true;
        ui.toast(db.friendlyError(e), 'err');
      }
    }

    // ───── تحميل ─────
    async function load({ quiet = false } = {}) {
      if (loading) return;
      loading = true;
      if (!quiet) listEl.innerHTML = ui.skeleton(4);
      refreshBtn.disabled = true;
      refreshBtn.querySelector('i').classList.add('fa-spin');
      try {
        // العاجل أولاً (urgency_rank: 0 عاجل، 1 متوسط، 2 عادي) ثم الأقدم انتظاراً
        const { data, error } = await sb.from('delegate_open_orders').select('*')
          .order('urgency_rank', { ascending: true })
          .order('created_at', { ascending: true });
        if (error) throw error;
        orders = data || [];
        pickDefaultCity();
        renderChips();
        renderList();
        lastUpdated.textContent = 'آخر تحديث: ' + db.formatDate(new Date().toISOString());
      } catch (e) {
        listEl.innerHTML = `<div class="card"><div class="empty"><i class="fas fa-triangle-exclamation"></i>${esc(db.friendlyError(e))}</div></div>`;
        ui.toast(db.friendlyError(e), 'err');
      } finally {
        loading = false;
        refreshBtn.disabled = false;
        refreshBtn.querySelector('i').classList.remove('fa-spin');
      }
    }

    function countsByCity() {
      const counts = {};
      for (const o of orders) counts[o.city] = (counts[o.city] || 0) + 1;
      return counts;
    }

    // افتراضياً: مدينة المندوب إن كان فيها طلبات، وإلا كل المدن
    function pickDefaultCity() {
      if (cityTouched) {
        if (city && !orders.some(o => o.city === city)) { /* المدينة فرغت — نبقيها ليشوف الحالة الفارغة الموجّهة */ }
        return;
      }
      const own = profile.city;
      city = own && orders.some(o => o.city === own) ? own : null;
    }

    // ───── الشرائح ─────
    function renderChips() {
      const counts = countsByCity();
      const own = profile.city || null;
      const others = Object.keys(counts).filter(c => c !== own).sort((a, b) => a.localeCompare(b, 'ar'));
      const chips = [];
      if (own) chips.push({ key: own, label: own, n: counts[own] || 0, home: true });
      chips.push({ key: '__all', label: 'كل المدن', n: orders.length });
      for (const c of others) chips.push({ key: c, label: c, n: counts[c] });
      chipsEl.innerHTML = chips.map(c =>
        `<button type="button" class="chip ${(c.key === '__all' ? city === null : city === c.key) ? 'active' : ''}" data-city="${esc(c.key)}">
          ${c.home ? '<i class="fas fa-house"></i>' : ''}${esc(c.label)} <span class="n ltr">${c.n}</span>
        </button>`).join('');
    }
    chipsEl.addEventListener('click', e => {
      const c = e.target.closest('.chip[data-city]');
      if (!c) return;
      city = c.dataset.city === '__all' ? null : c.dataset.city;
      cityTouched = true;
      renderChips();
      renderList();
    });

    // ───── البطاقات ─────
    function renderList() {
      const visible = city ? orders.filter(o => o.city === city) : orders;
      if (!visible.length) {
        const hint = city && orders.length
          ? `<p>ما فيش طلبات في ${esc(city)} توا — في ${orders.length === 1 ? 'طلب واحد' : orders.length + ' طلبات'} في مدن ثانية.</p>
             <button type="button" class="btn btn-ghost btn-sm" data-all-cities><i class="fas fa-earth-africa"></i> شوف كل المدن</button>`
          : '';
        listEl.innerHTML = `<div class="card"><div class="empty"><i class="fas fa-mug-hot"></i>
          <strong>ما فيش طلبات متاحة توا — ارجع بعد شوية</strong>${hint}</div></div>`;
        return;
      }
      listEl.innerHTML = `<div class="order-cards">${visible.map(cardHtml).join('')}</div>`;
    }

    function urgencyBadge(u) {
      const cls = u === 'عاجل' ? 'badge-urgent' : u === 'متوسط' ? 'badge-mid' : 'off';
      return `<span class="badge ${cls}">${u === 'عاجل' ? '<i class="fas fa-bolt"></i> ' : ''}${esc(u || 'عادي')}</span>`;
    }

    function partHtml(o) {
      if (!o.car_model && !o.part_condition && !o.part_description) return '';
      const rows = [
        o.car_model ? `<dt>السيارة</dt><dd>${esc(o.car_model)}</dd>` : '',
        o.part_description ? `<dt>القطعة</dt><dd>${esc(o.part_description)}</dd>` : '',
        o.part_condition ? `<dt>الحالة</dt><dd>${esc(o.part_condition)}</dd>` : '',
      ].join('');
      return `<dl class="kv oc-part">${rows}</dl>`;
    }

    function cardHtml(o) {
      const urgent = o.urgency === 'عاجل';
      const claimBtn = canClaim
        ? `<button type="button" class="btn btn-primary btn-block" data-claim="${esc(o.id)}" data-code="${esc(o.code)}"><i class="fas fa-hand"></i> نحجز الطلب</button>`
        : `<button type="button" class="btn btn-ghost btn-block" disabled title="الحجز للمندوبين المعتمدين فقط"><i class="fas fa-lock"></i> الحجز للمندوبين</button>`;
      return `<article class="order-card ${urgent ? 'is-urgent' : ''}" data-id="${esc(o.id)}">
        <div class="oc-head">
          <span class="oc-code">${esc(o.code)}</span>
          ${urgencyBadge(o.urgency)}
        </div>
        <div class="oc-meta">
          <span><i class="fas fa-location-dot"></i>${esc(o.city)}</span>
          <span><i class="fas fa-tag"></i>${esc(o.category)}</span>
          <span><i class="fas fa-cubes"></i>الكمية: <b class="ltr">${esc(o.quantity)}</b></span>
          <span><i class="fas fa-clock"></i>${esc(timeAgo(o.created_at))}</span>
        </div>
        ${o.details
          ? `<div class="oc-details" data-expand title="اضغط لعرض كل التفاصيل">${esc(o.details)}</div>`
          : '<div class="oc-details muted">بلا تفاصيل إضافية</div>'}
        ${partHtml(o)}
        <div class="oc-foot">${claimBtn}</div>
      </article>`;
    }

    // ───── الحجز ─────
    listEl.addEventListener('click', async e => {
      const expand = e.target.closest('[data-expand]');
      if (expand) { expand.classList.toggle('expanded'); return; }

      if (e.target.closest('[data-all-cities]')) {
        city = null; cityTouched = true; renderChips(); renderList(); return;
      }

      const b = e.target.closest('button[data-claim]');
      if (!b) return;
      const id = b.dataset.claim;
      const code = b.dataset.code;
      const ok = await ui.confirm(`تحجز الطلب ${code}؟ بعد الحجز يظهرلك اسم الزبون ورقمه وتصير مسؤول عن تدويره وتوصيله.`, { okText: 'نعم، نحجزه' });
      if (!ok) return;

      const original = b.innerHTML;
      b.disabled = true;
      b.innerHTML = '<i class="fas fa-spinner fa-spin"></i> لحظة…';
      try {
        const claimed = await db.claimOrder(id);
        if (claimed) {
          ui.toast(`حجزت الطلب ${code} — كلّم الزبون توا`, 'ok');
          location.href = '/delegate/mine/?id=' + encodeURIComponent(id);
        } else {
          ui.toast('سبقك مندوب آخر على هذا الطلب', 'err');
          await load({ quiet: true });
        }
      } catch (err) {
        // too_many_active / not_allowed → رسالة ودّية من friendlyError
        ui.toast(db.friendlyError(err), 'err', 4500);
        b.disabled = false;
        b.innerHTML = original;
        if (String(err && err.message || '').includes('too_many_active')) { atLimit = true; limitNote.hidden = false; loadStats(); }
      }
    });

    // ───── التحديث: زر، سحب للتحديث على الجوال، والعودة للتبويب ─────
    refreshBtn.addEventListener('click', () => { load({ quiet: true }); loadStats(); });

    let startY = null, ready = false;
    document.addEventListener('touchstart', e => {
      startY = window.scrollY <= 0 && !document.body.classList.contains('modal-open') ? e.touches[0].clientY : null;
      ready = false;
    }, { passive: true });
    document.addEventListener('touchmove', e => {
      if (startY === null) return;
      const dy = e.touches[0].clientY - startY;
      if (dy < 24) { ptr.classList.remove('show', 'ready'); ready = false; return; }
      ready = dy > 90;
      ptr.classList.add('show');
      ptr.classList.toggle('ready', ready);
      ptr.querySelector('span').textContent = ready ? 'اطلق للتحديث' : 'اسحب للتحديث';
    }, { passive: true });
    document.addEventListener('touchend', () => {
      ptr.classList.remove('show', 'ready');
      if (ready) load({ quiet: true });
      startY = null; ready = false;
    }, { passive: true });

    document.addEventListener('visibilitychange', () => { if (!document.hidden) { load({ quiet: true }); loadStats(); } });
    setInterval(() => { if (!document.hidden && !document.body.classList.contains('modal-open')) load({ quiet: true }); }, 90 * 1000);

    // ───── الوقت النسبي باللهجة ─────
    function timeAgo(iso) {
      const s = (Date.now() - new Date(iso).getTime()) / 1000;
      if (!Number.isFinite(s)) return '';
      if (s < 60) return 'توا';
      const m = Math.floor(s / 60);
      if (m < 60) return m === 1 ? 'قبل دقيقة' : m === 2 ? 'قبل دقيقتين' : m <= 10 ? `قبل ${m} دقايق` : `قبل ${m} دقيقة`;
      const h = Math.floor(m / 60);
      if (h < 24) return h === 1 ? 'قبل ساعة' : h === 2 ? 'قبل ساعتين' : h <= 10 ? `قبل ${h} ساعات` : `قبل ${h} ساعة`;
      const d = Math.floor(h / 24);
      if (d === 1) return 'أمس';
      if (d === 2) return 'قبل يومين';
      if (d < 7) return `قبل ${d} أيام`;
      return db.formatDate(iso);
    }

    loadStats();
    load();
  }
</script>
