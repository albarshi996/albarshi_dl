---
// بوابة المندوب — طلباتي: الطلبات المحجوزة لي (view: delegate_my_orders بلا الأعمدة الداخلية).
// كل تغيير حالة يمرّ عبر RPC set_order_status (خطوة واحدة للأمام فقط — الحارس في القاعدة يرفض غيرها).
// ?id=<uuid> يبرز بطاقة الطلب ويمرّر إليها (يُستخدم بعد الحجز من صفحة الطلبات المتاحة).
import AdminLayout from '../../layouts/AdminLayout.astro';
---

<AdminLayout title="طلباتي" portal="delegate" page="mine">
  <button slot="actions" type="button" class="btn btn-ghost btn-sm" id="refreshBtn">
    <i class="fas fa-rotate"></i> <span>تحديث</span>
  </button>

  <div class="stats" id="stats" hidden></div>

  <div id="adminNote" class="mine-note" hidden>
    <i class="fas fa-circle-info"></i> أنت تتصفح كمدير — هنا تظهر الطلبات المسندة لحسابك فقط. إدارة كل الطلبات من <a href="/admin/orders/">لوحة الطلبات</a>.
  </div>

  <div class="chips mine-tabs" id="tabs" role="tablist" aria-label="تصنيف الطلبات"></div>

  <div id="list"></div>

  <p class="muted small" id="lastUpdated"></p>
</AdminLayout>

<style is:global>
  body[data-page="mine"] .mine-note {
    display: flex; align-items: center; gap: .6rem; flex-wrap: wrap; font-size: .88rem; color: var(--muted);
    background: rgba(56,189,248,.08); border: 1px solid rgba(56,189,248,.3); border-radius: var(--r); padding: .7rem .9rem;
  }
  body[data-page="mine"] .mine-note i { color: var(--info); }
  body[data-page="mine"] .small { font-size: .8rem; text-align: center; }
  body[data-page="mine"] .stat-link { display: block; color: inherit; border-radius: var(--r-lg); transition: transform var(--dur) var(--ease); }
  body[data-page="mine"] .stat-link .stat { height: 100%; border-color: rgba(56,189,248,.35); }
  body[data-page="mine"] .stat-link:hover { transform: translateY(-2px); }
  body[data-page="mine"] .mine-tabs .chip { padding: .55rem 1rem; font-size: .9rem; }
  body[data-page="mine"] .mine-tabs .chip .n { opacity: .75; font-size: .75rem; margin-right: .2rem; }

  body[data-page="mine"] .order-card { gap: .75rem; }
  body[data-page="mine"] .order-card.is-urgent { border-color: rgba(239,68,68,.4); }
  body[data-page="mine"] .order-card.is-highlight { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(245,165,36,.25); }
  body[data-page="mine"] .order-card.is-done { opacity: .9; }
  body[data-page="mine"] .order-card.is-busy { opacity: .6; pointer-events: none; }
  body[data-page="mine"] .badge.badge-urgent { background: rgba(239,68,68,.16); color: #FCA5A5; border-color: rgba(239,68,68,.4); }
  body[data-page="mine"] .badge.badge-mid { background: rgba(250,204,21,.12); color: #FDE68A; border-color: rgba(250,204,21,.35); }

  body[data-page="mine"] .oc-customer {
    display: flex; align-items: center; justify-content: space-between; gap: .6rem; flex-wrap: wrap;
    background: rgba(255,255,255,.03); border: 1px solid var(--line); border-radius: var(--r); padding: .7rem .8rem;
  }
  body[data-page="mine"] .oc-cust { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
  body[data-page="mine"] .oc-cust-name { font-weight: 700; color: var(--white); }
  body[data-page="mine"] .oc-cust-name i { color: var(--primary); margin-left: .3rem; font-size: .85em; }
  body[data-page="mine"] .oc-cust-phone { color: var(--muted); font-size: .9rem; }
  body[data-page="mine"] .oc-contact { display: flex; gap: .4rem; }
  body[data-page="mine"] .oc-contact .btn { min-height: 40px; }
  body[data-page="mine"] .oc-meta i { color: var(--muted-2); margin-left: .2rem; }
  body[data-page="mine"] .oc-meta .badge { font-size: .72rem; padding: .15rem .55rem; }
  body[data-page="mine"] .oc-details { cursor: pointer; }
  body[data-page="mine"] .oc-details.expanded { max-height: none; }
  body[data-page="mine"] .oc-part, body[data-page="mine"] .oc-price {
    font-size: .88rem; background: rgba(255,255,255,.03); border: 1px dashed var(--line-2); border-radius: var(--r); padding: .6rem .8rem;
  }
  body[data-page="mine"] .oc-price { border-style: solid; border-color: rgba(245,165,36,.3); }
  body[data-page="mine"] .oc-price dd strong { color: var(--primary-light); font-size: 1.02rem; }
  body[data-page="mine"] .oc-quote { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; font-size: .88rem; font-weight: 700; border-radius: var(--r); padding: .55rem .8rem; }
  body[data-page="mine"] .oc-quote.ok { background: rgba(34,197,94,.12); border: 1px solid rgba(34,197,94,.35); color: #86EFAC; }
  body[data-page="mine"] .oc-quote.no { background: rgba(239,68,68,.12); border: 1px solid rgba(239,68,68,.35); color: #FCA5A5; }
  body[data-page="mine"] .oc-quote.wait { background: rgba(56,189,248,.1); border: 1px solid rgba(56,189,248,.3); color: #7DD3FC; }
  body[data-page="mine"] .oc-quote small { font-weight: 500; }
  body[data-page="mine"] .oc-dates { display: flex; gap: .8rem; flex-wrap: wrap; color: var(--muted-2); font-size: .78rem; }
  body[data-page="mine"] .oc-dates i { margin-left: .2rem; }

  body[data-page="mine"] .tl-toggle {
    width: 100%; display: flex; align-items: center; gap: .5rem; background: none; border: 0; border-top: 1px solid var(--line);
    color: var(--muted); font-weight: 700; font-size: .85rem; padding: .6rem 0 0; cursor: pointer;
  }
  body[data-page="mine"] .tl-toggle:hover { color: var(--text); }
  body[data-page="mine"] .tl-toggle .chev { margin-right: auto; transition: transform var(--dur); }
  body[data-page="mine"] .tl-toggle[aria-expanded="true"] .chev { transform: rotate(180deg); }
  body[data-page="mine"] .tl-body { padding-top: .6rem; }
  body[data-page="mine"] .ev-line { display: flex; align-items: center; gap: .5rem; flex-wrap: wrap; }
  body[data-page="mine"] .ev-actor { font-size: .8rem; }

  body[data-page="mine"] .oc-foot { border-top: 1px solid var(--line); padding-top: .75rem; }
  body[data-page="mine"] .oc-foot .btn { min-height: 48px; flex: 1 1 auto; }
  body[data-page="mine"] .oc-foot .btn-primary { flex-basis: 100%; font-size: 1rem; }
  body[data-page="mine"] .total-line { flex-direction: row; align-items: center; justify-content: space-between; background: rgba(245,165,36,.08); border: 1px solid rgba(245,165,36,.3); border-radius: var(--r); padding: .6rem .9rem; }
  body[data-page="mine"] .total-line strong { color: var(--primary-light); font-size: 1.1rem; }
  body[data-page="mine"] .empty .btn { margin-top: .9rem; }
  @media (max-width: 640px) {
    body[data-page="mine"] .order-cards { grid-template-columns: 1fr; }
    body[data-page="mine"] .oc-contact { width: 100%; }
    body[data-page="mine"] .oc-contact .btn { flex: 1; }
  }
</style>

<script>
  // @ts-nocheck
  const { db, ui, sb, profile } = await window.dawerliReady;

  if (sb && profile) init();

  function init() {
    const esc = db.esc;
    const ACTIVE = ['received', 'searching', 'quoted', 'purchasing', 'shipping'];
    // الخطوة التالية المسموحة للمندوب (الحارس في القاعدة يفرضها أيضاً)
    const NEXT = { received: 'searching', searching: 'quoted', quoted: 'purchasing', purchasing: 'shipping', shipping: 'delivered' };
    const TABS = [
      { key: 'active',    label: 'جارية', icon: 'fa-person-running', match: o => ACTIVE.includes(o.status) },
      { key: 'delivered', label: 'وصلت',  icon: 'fa-circle-check',   match: o => o.status === 'delivered' },
      { key: 'cancelled', label: 'ملغية', icon: 'fa-ban',            match: o => o.status === 'cancelled' },
    ];
    // الحقول التي نأخذها من صف الطلب الراجع من set_order_status (نفس أعمدة الـ view)
    const MERGE_KEYS = ['status', 'quoted_price', 'service_fee', 'total', 'quote_response', 'quote_responded_at',
      'quoted_at', 'status_changed_at', 'delivered_at', 'updated_at', 'supplier_id', 'product_id'];

    const listEl = document.getElementById('list');
    const tabsEl = document.getElementById('tabs');
    const statsEl = document.getElementById('stats');
    const refreshBtn = document.getElementById('refreshBtn');
    const lastUpdated = document.getElementById('lastUpdated');
    const adminNote = document.getElementById('adminNote');

    adminNote.hidden = profile.role !== 'admin';

    const params = new URLSearchParams(location.search);
    let highlightId = params.get('id') || null;   // البطاقة المبرَزة (تبقى ثواني ثم تزول)
    let pendingHighlight = !!highlightId;         // التمرير إليها مرة واحدة فقط بعد أول تحميل
    let orders = [];
    let tab = 'active';
    let loading = false;
    let reloadQueued = false;        // طُلب تحديث أثناء تحميل جارٍ — ننفّذه بعده حتى لا يضيع
    let loadSeq = 0;
    const eventsCache = new Map();   // order_id → events[]
    const expanded = new Set();      // البطاقات المفتوح سجلها
    const inflight = new Set();

    // ───── التحميل ─────
    async function load({ quiet = false } = {}) {
      if (loading) { reloadQueued = true; return; }
      loading = true;
      const seq = ++loadSeq;
      if (!quiet) listEl.innerHTML = ui.skeleton(4);
      refreshBtn.disabled = true;
      refreshBtn.querySelector('i').classList.add('fa-spin');
      try {
        const { data, error } = await sb.from('delegate_my_orders').select('*').order('created_at', { ascending: false });
        if (error) throw error;
        if (seq !== loadSeq) return;
        orders = data || [];
        renderTabs();
        renderList();
        lastUpdated.textContent = 'آخر تحديث: ' + db.formatDate(new Date().toISOString());
        applyHighlight();
      } catch (e) {
        if (seq !== loadSeq) return;
        listEl.innerHTML = `<div class="card"><div class="empty"><i class="fas fa-triangle-exclamation"></i>${esc(db.friendlyError(e))}</div></div>`;
        ui.toast(db.friendlyError(e), 'err');
      } finally {
        loading = false;
        refreshBtn.disabled = false;
        refreshBtn.querySelector('i').classList.remove('fa-spin');
        if (reloadQueued) { reloadQueued = false; load({ quiet: true }); }
      }
    }

    async function loadStats() {
      try {
        const s = await db.delegateStats();
        if (!s) { statsEl.hidden = true; return; } // المدير ليس مندوباً — الدالة ترجع null
        statsEl.hidden = false;
        statsEl.innerHTML = [
          ui.statTile({ label: 'طلبات جارية',      value: s.active ?? 0,          icon: 'fa-person-running', tone: 'accent' }),
          ui.statTile({ label: 'وصلت هذا الشهر',   value: s.delivered_month ?? 0, icon: 'fa-circle-check',   tone: 'success' }),
          ui.statTile({ label: 'وصلت إجمالاً',     value: s.delivered_total ?? 0, icon: 'fa-trophy' }),
          ui.statTile({ label: 'عمولتك هذا الشهر', value: db.formatMoney(s.commission_month), icon: 'fa-coins' }),
          `<a href="/delegate/" class="stat-link" title="شوف الطلبات المتاحة للحجز">${ui.statTile({ label: 'طلبات متاحة للحجز', value: s.open_pool ?? 0, icon: 'fa-magnifying-glass', tone: 'info' })}</a>`,
        ].join('');
      } catch (e) {
        statsEl.hidden = true;
        ui.toast(db.friendlyError(e), 'err');
      }
    }

    // ───── التبويبات ─────
    function renderTabs() {
      tabsEl.innerHTML = TABS.map(t => {
        const n = orders.filter(t.match).length;
        const on = tab === t.key;
        return `<button type="button" role="tab" class="chip ${on ? 'active' : ''}" data-tab="${t.key}" aria-selected="${on ? 'true' : 'false'}">
          <i class="fas ${t.icon}"></i> ${t.label} <span class="n ltr">${n}</span></button>`;
      }).join('');
    }
    tabsEl.addEventListener('click', e => {
      const b = e.target.closest('[data-tab]');
      if (!b || b.dataset.tab === tab) return;
      tab = b.dataset.tab;
      renderTabs();
      renderList();
    });

    // ───── القائمة ─────
    function renderList() {
      const t = TABS.find(x => x.key === tab) || TABS[0];
      const visible = orders.filter(t.match);
      if (!visible.length) {
        listEl.innerHTML = `<div class="card"><div class="empty">${emptyHtml(tab)}</div></div>`;
        return;
      }
      listEl.innerHTML = `<div class="order-cards">${visible.map(cardHtml).join('')}</div>`;
      for (const id of expanded) if (!eventsCache.has(id) && visible.some(o => o.id === id)) fetchTimeline(id);
    }

    function emptyHtml(key) {
      if (key === 'active') return `<i class="fas fa-mug-hot"></i><strong>ما عندكش طلبات جارية توا</strong>
        <p>احجز طلباً من الطلبات المتاحة وابدأ تدوّر.</p>
        <a class="btn btn-primary" href="/delegate/"><i class="fas fa-magnifying-glass"></i> شوف الطلبات المتاحة</a>`;
      if (key === 'delivered') return '<i class="fas fa-box-open"></i><strong>لسّا ما وصّلت طلبات</strong><p>أول طلب توصّله يظهر هنا مع عمولتك.</p>';
      return '<i class="fas fa-thumbs-up"></i><strong>ما فيش طلبات ملغية</strong><p>ممتاز — كمّل على هالحال.</p>';
    }

    function cardEl(id) {
      return Array.from(listEl.querySelectorAll('.order-card[data-id]')).find(el => el.dataset.id === id) || null;
    }

    function urgencyBadge(u) {
      const cls = u === 'عاجل' ? 'badge-urgent' : u === 'متوسط' ? 'badge-mid' : 'off';
      return `<span class="badge ${cls}">${u === 'عاجل' ? '<i class="fas fa-bolt"></i> ' : ''}${esc(u || 'عادي')}</span>`;
    }

    function waHref(phone) {
      let d = String(phone || '').replace(/\D/g, '');
      if (!d) return '#';
      if (d.startsWith('00')) d = d.slice(2);
      if (d.startsWith('0')) d = '218' + d.slice(1);
      else if (!d.startsWith('218')) d = '218' + d;
      return 'https://wa.me/' + d;
    }

    function partHtml(o) {
      if (!o.car_model && !o.part_condition && !o.part_description) return '';
      const rows = [
        o.car_model ? `<dt>السيارة</dt><dd>${esc(o.car_model)}</dd>` : '',
        o.part_description ? `<dt>القطعة</dt><dd>${esc(o.part_description)}</dd>` : '',
        o.part_condition ? `<dt>الحالة</dt><dd>${esc(o.part_condition)}</dd>` : '',
      ].join('');
      return `<dl class="kv oc-part">${rows}</dl>`;
    }

    function pricingHtml(o) {
      if (o.quoted_price == null && o.service_fee == null && o.total == null) return '';
      return `<dl class="kv oc-price">
        <dt>سعر السلعة</dt><dd>${esc(db.formatMoney(o.quoted_price))}</dd>
        <dt>رسوم الخدمة</dt><dd>${esc(db.formatMoney(o.service_fee))}</dd>
        <dt>الإجمالي</dt><dd><strong>${esc(db.formatMoney(o.total))}</strong></dd>
      </dl>`;
    }

    function quoteNoticeHtml(o) {
      if (o.quote_response === 'accepted') {
        return `<div class="oc-quote ok"><i class="fas fa-circle-check"></i><span>وافق الزبون على عرض السعر ✓</span>
          ${o.quote_responded_at ? `<small>${esc(db.formatDate(o.quote_responded_at))}</small>` : ''}</div>`;
      }
      if (o.quote_response === 'rejected') {
        return `<div class="oc-quote no"><i class="fas fa-circle-xmark"></i><span>الزبون رفض عرض السعر ✗</span>
          ${o.quote_responded_at ? `<small>${esc(db.formatDate(o.quote_responded_at))}</small>` : ''}
          <small>كلّمه وعدّل العرض أو كمّل بالشراء إن اتفقتوا.</small></div>`;
      }
      if (o.status === 'quoted') {
        return '<div class="oc-quote wait"><i class="fas fa-hourglass-half"></i><span>بانتظار رد الزبون على العرض</span><small>يقدر يوافق من صفحة التتبع، أو كلّمه على الواتساب.</small></div>';
      }
      return '';
    }

    function datesHtml(o) {
      const parts = [];
      if (o.assigned_at) parts.push(`<span title="${esc(db.formatDate(o.assigned_at))}"><i class="fas fa-hand"></i>حجزته ${esc(timeAgo(o.assigned_at))}</span>`);
      if (o.status === 'delivered' && o.delivered_at) parts.push(`<span><i class="fas fa-circle-check"></i>وصل: ${esc(db.formatDate(o.delivered_at))}</span>`);
      else if (o.status === 'cancelled') parts.push(`<span><i class="fas fa-ban"></i>أُلغي: ${esc(db.formatDate(o.status_changed_at))}</span>`);
      else if (o.status_changed_at) parts.push(`<span><i class="fas fa-clock-rotate-left"></i>آخر تحديث ${esc(timeAgo(o.status_changed_at))}</span>`);
      return parts.length ? `<div class="oc-dates">${parts.join('')}</div>` : '';
    }

    function cardHtml(o) {
      const isActive = ACTIVE.includes(o.status);
      const phone = String(o.customer_phone || '');
      const isOpen = expanded.has(o.id);
      const cls = ['order-card', o.urgency === 'عاجل' && isActive ? 'is-urgent' : '', o.id === highlightId ? 'is-highlight' : '', isActive ? '' : 'is-done']
        .filter(Boolean).join(' ');
      return `<article class="${cls}" data-id="${esc(o.id)}">
        <div class="oc-head">
          <span class="oc-code">${esc(o.code)}</span>
          ${ui.statusBadge(o.status)}
        </div>
        <div class="oc-customer">
          <div class="oc-cust">
            <span class="oc-cust-name"><i class="fas fa-user"></i>${esc(o.customer_name)}</span>
            <span class="oc-cust-phone ltr mono">${esc(phone)}</span>
          </div>
          <div class="oc-contact">
            <a class="btn btn-wa btn-sm" href="${esc(waHref(phone))}" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> واتساب</a>
            <a class="btn btn-ghost btn-sm" href="tel:${esc(phone)}"><i class="fas fa-phone"></i> اتصال</a>
          </div>
        </div>
        <div class="oc-meta">
          <span><i class="fas fa-location-dot"></i>${esc(o.city)}</span>
          <span><i class="fas fa-tag"></i>${esc(o.category)}</span>
          <span><i class="fas fa-cubes"></i>الكمية: <b class="ltr">${esc(o.quantity)}</b></span>
          <span>${urgencyBadge(o.urgency)}</span>
          <span><i class="fas fa-wallet"></i>${esc(db.PAYMENT_LABELS[o.payment_method] || o.payment_method || '—')}</span>
        </div>
        ${o.details
          ? `<div class="oc-details" data-expand title="اضغط لعرض كل التفاصيل">${esc(o.details)}</div>`
          : '<div class="oc-details muted">بلا تفاصيل إضافية</div>'}
        ${partHtml(o)}
        ${pricingHtml(o)}
        ${quoteNoticeHtml(o)}
        ${datesHtml(o)}
        <div class="oc-timeline">
          <button type="button" class="tl-toggle" data-toggle-tl aria-expanded="${isOpen ? 'true' : 'false'}">
            <i class="fas fa-clock-rotate-left"></i> سجل الطلب <i class="fas fa-chevron-down chev"></i>
          </button>
          <div class="tl-body" ${isOpen ? '' : 'hidden'}>${isOpen ? (eventsCache.has(o.id) ? timelineHtml(eventsCache.get(o.id)) : ui.skeleton(2)) : ''}</div>
        </div>
        ${isActive ? actionsHtml(o) : ''}
      </article>`;
    }

    const actBtn = (act, cls, icon, label) =>
      `<button type="button" class="btn ${cls}" data-act="${act}"><i class="fas ${icon}"></i> ${esc(label)}</button>`;

    function actionsHtml(o) {
      const next = NEXT[o.status];
      const nextLabel = next ? 'التالي: ' + (db.STATUS_LABELS[next] || next) : '';
      const b = [];
      if (o.status === 'searching') {
        b.push(actBtn('quote', 'btn-primary', 'fa-tags', nextLabel));
        b.push(actBtn('direct', 'btn-ghost', 'fa-cart-shopping', 'شراء مباشر بلا عرض'));
      } else if (o.status === 'quoted') {
        b.push(actBtn('advance', 'btn-primary', 'fa-cart-shopping', nextLabel));
        b.push(actBtn('quote', 'btn-ghost', 'fa-pen', 'تعديل العرض'));
      } else if (o.status === 'purchasing') {
        b.push(actBtn('advance', 'btn-primary', 'fa-truck-fast', nextLabel));
      } else if (o.status === 'shipping') {
        b.push(actBtn('advance', 'btn-success', 'fa-circle-check', nextLabel));
      } else if (o.status === 'received') {
        b.push(actBtn('advance', 'btn-primary', 'fa-magnifying-glass', nextLabel));
      }
      b.push(actBtn('note', 'btn-ghost', 'fa-comment-dots', 'ملاحظة للزبون'));
      return `<div class="oc-foot">${b.join('')}</div>`;
    }

    // ───── سجل الأحداث ─────
    async function fetchTimeline(id) {
      if (inflight.has(id)) return;
      inflight.add(id);
      try {
        const { data, error } = await sb.from('order_events')
          .select('id,kind,status,note,actor_id,created_at')
          .eq('order_id', id)
          .order('created_at', { ascending: true }).order('id', { ascending: true });
        if (error) throw error;
        eventsCache.set(id, data || []);
        paintTimeline(id);
      } catch (e) {
        paintTimeline(id, db.friendlyError(e));
      } finally {
        inflight.delete(id);
      }
    }

    function paintTimeline(id, errMsg) {
      const el = cardEl(id);
      const body = el && el.querySelector('.tl-body');
      if (!body) return;
      body.innerHTML = errMsg
        ? `<p class="form-error">${esc(errMsg)}</p>`
        : timelineHtml(eventsCache.get(id) || []);
    }

    function eventBadge(ev) {
      if (ev.kind === 'note') return '<span class="badge off"><i class="fas fa-comment"></i> ملاحظة</span>';
      if (ev.kind === 'assign') return '<span class="badge st-searching"><i class="fas fa-hand"></i> حُجز الطلب</span>';
      if (ev.kind === 'unassign') return '<span class="badge off"><i class="fas fa-user-slash"></i> أُلغي الإسناد</span>';
      return ui.statusBadge(ev.status);
    }

    // المندوب لا يقرأ ملفات الآخرين (RLS) فلا نضمّن profiles(full_name): نسمّي الفاعل من هويته فقط.
    // غير المندوب نفسه = الإدارة؛ أمّا المدير المتصفح هنا فقد يرى أحداث مندوب أو مدير آخر.
    function actorLabel(ev) {
      if (ev.actor_id && ev.actor_id === profile.id) return 'أنت';
      if (ev.actor_id) return profile.role === 'admin' ? 'مستخدم آخر' : 'الإدارة';
      return ev.kind === 'note' ? 'الزبون' : 'الموقع';
    }

    function timelineHtml(events) {
      if (!events.length) return '<p class="muted">لا أحداث مسجّلة بعد.</p>';
      return `<ul class="events">${events.map(ev => `<li><div>
          <div class="ev-line">${eventBadge(ev)}<span class="ev-actor muted"><i class="fas fa-user"></i> ${esc(actorLabel(ev))}</span></div>
          <div class="ev-time">${esc(db.formatDate(ev.created_at))}</div>
          ${ev.note ? `<div class="ev-note">${esc(ev.note)}</div>` : ''}
        </div></li>`).join('')}</ul>`;
    }

    // ───── تغيير الحالة ─────
    function mergeOrder(id, row) {
      const o = orders.find(x => x.id === id);
      if (!o || !row) return;
      for (const k of MERGE_KEYS) if (k in row) o[k] = row[k];
    }

    // ينفّذ RPC ويحوّل الخطأ لرسالة ودّية تعرضها نافذة النموذج
    async function apply(o, status, opts) {
      try {
        const row = await db.setOrderStatus(o.id, status, opts);
        mergeOrder(o.id, row);
        return row;
      } catch (e) {
        const err = new Error(db.friendlyError(e));
        err.friendly = err.message;
        throw err;
      }
    }

    async function afterChange(o, okMsg) {
      eventsCache.delete(o.id);
      ui.toast(okMsg, 'ok');
      renderTabs();
      renderList();
      loadStats();
      load({ quiet: true });
    }

    const NOTE_FIELD = (required = false) => ({
      name: 'note', type: 'textarea', rows: 2, required,
      label: required ? 'الملاحظة' : 'ملاحظة تظهر للزبون في صفحة التتبع (اختياري)',
      placeholder: 'مثال: لقينا القطعة أصلية عند مورد في بنغازي — التسليم خلال يومين',
    });

    // خطوة واحدة للأمام مع ملاحظة اختيارية
    async function advance(o, next, { title, hint, submitText } = {}) {
      const label = db.STATUS_LABELS[next] || next;
      const field = NOTE_FIELD(false);
      if (hint) field.hint = hint;
      const res = await ui.form({
        title: title || ('التالي: ' + label),
        fields: [field],
        submitText: submitText || ('تأكيد — ' + label),
        onSubmit: v => apply(o, next, { note: v.note }),
      });
      if (res) afterChange(o, `تم تحديث الطلب ${o.code} إلى «${label}»`);
    }

    async function noteOnly(o) {
      const res = await ui.form({
        title: 'ملاحظة للزبون',
        fields: [{ ...NOTE_FIELD(true), rows: 3, hint: 'تظهر للزبون في صفحة تتبع الطلب فوراً' }],
        submitText: 'إرسال الملاحظة',
        onSubmit: v => apply(o, o.status, { note: v.note }),
      });
      if (res) afterChange(o, 'وصلت ملاحظتك للزبون ✓');
    }

    // عرض السعر: سعر + رسوم (مطلوبان) + ملاحظة اختيارية، والإجمالي يُحسب تلقائياً
    function quoteForm(o) {
      const edit = o.status === 'quoted';
      return new Promise(resolve => {
        const fields = [
          { name: 'quoted_price', label: 'سعر السلعة (د.ل)', type: 'number', required: true, min: 0, step: '0.01', inputmode: 'decimal', placeholder: '0' },
          { name: 'service_fee',  label: 'رسوم الخدمة (د.ل)', type: 'number', required: true, min: 0, step: '0.01', inputmode: 'decimal', placeholder: '0' },
          NOTE_FIELD(false),
        ];
        const n = v => (v === null || v === undefined) ? '' : String(v);
        const values = { quoted_price: n(o.quoted_price), service_fee: n(o.service_fee) };
        const body = `<form class="form-grid" novalidate>
          ${fields.map(f => ui.fieldHtml(f, values[f.name])).join('')}
          <div class="field full total-line"><span class="label">الإجمالي اللي يشوفه الزبون</span><strong class="ltr" data-total>—</strong></div>
          <p class="form-error" data-error hidden></p>
        </form>`;
        const m = ui.modal({
          title: edit ? 'تعديل عرض السعر' : 'التالي: عرض السعر',
          body,
          footer: `<button type="button" class="btn btn-ghost" data-close>إلغاء</button>
                   <button type="button" class="btn btn-primary" data-submit><i class="fas fa-paper-plane"></i> ${edit ? 'حفظ العرض' : 'إرسال العرض للزبون'}</button>`,
        });
        const form = m.querySelector('form');
        const errEl = m.querySelector('[data-error]');
        const totalEl = m.querySelector('[data-total]');
        const qp = form.elements.quoted_price, sf = form.elements.service_fee;
        const showErr = msg => { errEl.textContent = msg; errEl.hidden = false; };
        const calc = () => {
          const a = qp.value === '' ? NaN : Number(qp.value), b = sf.value === '' ? NaN : Number(sf.value);
          const sum = Math.round((a + b) * 100) / 100;
          totalEl.textContent = Number.isFinite(sum) ? db.formatMoney(sum) : '—';
          return sum;
        };
        qp.addEventListener('input', calc);
        sf.addEventListener('input', calc);
        calc();
        let done = false;
        const submit = async () => {
          const price = qp.value === '' ? null : Number(qp.value);
          const fee = sf.value === '' ? null : Number(sf.value);
          if (price === null || Number.isNaN(price) || price < 0) { showErr('اكتب سعر السلعة — رقم صفر أو أكثر.'); qp.focus(); return; }
          if (fee === null || Number.isNaN(fee) || fee < 0) { showErr('اكتب رسوم الخدمة — رقم صفر أو أكثر.'); sf.focus(); return; }
          const total = calc();
          const note = String(form.elements.note.value || '').trim() || null;
          errEl.hidden = true;
          const btn = m.querySelector('[data-submit]');
          btn.disabled = true;
          try {
            const row = await apply(o, 'quoted', { quoted_price: price, service_fee: fee, total, note });
            done = true; m.close(); resolve(row || true);
          } catch (e) {
            showErr(e.friendly || e.message);
          } finally { btn.disabled = false; }
        };
        m.querySelector('[data-submit]').addEventListener('click', submit);
        form.addEventListener('submit', e => { e.preventDefault(); submit(); });
        m.addEventListener('closed', () => { if (!done) resolve(null); }, { once: true });
      });
    }

    const ACTIONS = {
      async quote(o) {
        const edit = o.status === 'quoted';
        const res = await quoteForm(o);
        if (res) afterChange(o, edit ? 'تم تعديل عرض السعر ✓' : `أرسلنا عرض السعر للزبون على الطلب ${o.code}`);
      },
      async direct(o) {
        await advance(o, 'purchasing', {
          title: 'شراء مباشر بلا عرض سعر',
          hint: 'استخدمه لمّا يكون السعر متفق عليه مسبقاً مع الزبون أو الطلب بلا تسعير.',
          submitText: 'تأكيد — الشراء والتجهيز',
        });
      },
      async advance(o) {
        const next = NEXT[o.status];
        if (!next) return;
        const hint = next === 'delivered'
          ? 'تأكد أن الزبون استلم الطلب ودفع — بعد التسليم ما تقدرش ترجّع الحالة.'
          : next === 'shipping' ? 'اكتب للزبون متى يتوقع الوصول.' : undefined;
        await advance(o, next, { hint });
      },
      note: noteOnly,
    };

    // ───── الأحداث ─────
    listEl.addEventListener('click', async e => {
      const expand = e.target.closest('[data-expand]');
      if (expand) { expand.classList.toggle('expanded'); return; }

      const tl = e.target.closest('[data-toggle-tl]');
      if (tl) {
        const card = tl.closest('.order-card');
        const id = card.dataset.id;
        const body = card.querySelector('.tl-body');
        const open = !expanded.has(id);
        if (open) expanded.add(id); else expanded.delete(id);
        tl.setAttribute('aria-expanded', open ? 'true' : 'false');
        body.hidden = !open;
        if (open) {
          if (eventsCache.has(id)) body.innerHTML = timelineHtml(eventsCache.get(id));
          else { body.innerHTML = ui.skeleton(2); fetchTimeline(id); }
        }
        return;
      }

      const b = e.target.closest('button[data-act]');
      if (!b) return;
      const card = b.closest('.order-card');
      const o = orders.find(x => x.id === card.dataset.id);
      const fn = ACTIONS[b.dataset.act];
      if (!o || !fn) return;
      card.classList.add('is-busy');
      try { await fn(o); }
      catch (err) { ui.toast(db.friendlyError(err), 'err'); }
      finally { const c = cardEl(o.id); if (c) c.classList.remove('is-busy'); }
    });

    // ───── إبراز الطلب القادم من ?id= ─────
    function applyHighlight() {
      if (!pendingHighlight || !highlightId) return;
      pendingHighlight = false;
      const id = highlightId;
      const o = orders.find(x => x.id === id);
      history.replaceState(null, '', location.pathname);
      if (!o) { ui.toast('هذا الطلب مش في قائمتك.', 'info'); highlightId = null; return; }
      const t = TABS.find(x => x.match(o));
      if (t && t.key !== tab) { tab = t.key; renderTabs(); renderList(); }
      const el = cardEl(id);
      if (el) setTimeout(() => el.scrollIntoView({ behavior: 'smooth', block: 'center' }), 60);
      setTimeout(() => {
        highlightId = null;
        const c = cardEl(id);
        if (c) c.classList.remove('is-highlight');
      }, 8000);
    }

    // ───── التحديث ─────
    refreshBtn.addEventListener('click', () => { load({ quiet: true }); loadStats(); });
    document.addEventListener('visibilitychange', () => { if (!document.hidden) { load({ quiet: true }); loadStats(); } });
    setInterval(() => { if (!document.hidden && !document.body.classList.contains('modal-open')) load({ quiet: true }); }, 120 * 1000);

    // ───── الوقت النسبي باللهجة ─────
    function timeAgo(iso) {
      const s = (Date.now() - new Date(iso).getTime()) / 1000;
      if (!Number.isFinite(s)) return '';
      if (s < 60) return 'توا';
      const m = Math.floor(s / 60);
      if (m < 60) return m === 1 ? 'قبل دقيقة' : m === 2 ? 'قبل دقيقتين' : m <= 10 ? `قبل ${m} دقايق` : `قبل ${m} دقيقة`;
      const h = Math.floor(m / 60);
      if (h < 24) return h === 1 ? 'قبل ساعة' : h === 2 ? 'قبل ساعتين' : h <= 10 ? `قبل ${h} ساعات` : `قبل ${h} ساعة`;
      const d = Math.floor(h / 24);
      if (d === 1) return 'أمس';
      if (d === 2) return 'قبل يومين';
      if (d < 7) return `قبل ${d} أيام`;
      return db.formatDate(iso);
    }

    loadStats();
    load();
  }
</script>
