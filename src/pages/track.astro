      <!-- Stage 4: تم التسليم -->
      <li class="tl-item" data-stage-idx="4">
        <div class="tl-icon"><i class="fas fa-check-circle"></i></div>
        <div class="tl-body">
          <div class="tl-title">
            <span data-tl-ar="تم التسليم بنجاح" data-tl-en="Successfully Delivered">تم التسليم بنجاح</span>
            <span class="tl-badge" data-badge-done="✓ مُسلَّم" data-badge-active="جاري" data-badge-pending="قادم"></span>
          </div>
          <p class="tl-desc" data-tl-ar="وصل طلبك! نأمل أن تكون راضياً عن خدمتنا. شاركنا تقييمك عبر واتساب." data-tl-en="Your order has arrived! We hope you're satisfied with our service. Share your feedback via WhatsApp.">وصل طلبك! نأمل أن تكون راضياً عن خدمتنا. شاركنا تقييمك عبر واتساب.</p>
          <div class="tl-time"><i class="fas fa-star" style="color:#facc15;"></i> شاركنا رأيك</div>
        </div>
      </li>
    </ol>

    <!-- سجل تحديثات الطلب (من قاعدة البيانات) -->
    <div id="trackEvents" class="track-events" hidden>
      <h3><i class="fas fa-history"></i> سجل تحديثات طلبك</h3>
      <ul id="trackEventsList" class="ev-list"></ul>
      <p id="trackLastUpdate" class="ev-last"></p>
    </div>
  </div>

  <script is:inline>
  /* ════════════════════════════════════════════════════════════════
     TRACK PAGE SCRIPTS — WhatsApp lookup + Timeline interactivity
  ════════════════════════════════════════════════════════════════ */
  (function () {
    var WA_PHONE = '218946507954';
    var ORDER_REGEX = /^DW-\d{4}-\d{1,6}$/i;

    /* ── i18n helper ──────────────────────────────────────────── */
    function getLang() {
      try { return localStorage.getItem('dawerli_lang') || 'ar'; } catch(e) { return 'ar'; }
    }
    function getStr(key, fallback) {
      try {
        var d = window.dawerliDict;
        var lang = getLang();
        if (d && d[lang] && d[lang].strings && d[lang].strings[key]) return d[lang].strings[key];
      } catch(e) {}
      return fallback || key;
    }

    /* ── أدوات محلية ──────────────────────────────────────────── */
    // تهريب أي نص قادم من قاعدة البيانات قبل إدراجه في innerHTML
    function esc(s) {
      return String(s == null ? '' : s)
        .replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;').replace(/'/g, '&#39;');
    }
    function dbApi() {
      var d = window.dawerliDB;
      return (d && typeof d.isConfigured === 'function' && d.isConfigured()) ? d : null;
    }
    function waUrl(code) {
      var msg = getLang() === 'ar'
        ? 'السلام عليكم، أريد الاستعلام عن حالة طلبي رقم: ' + code
        : 'Hello, I would like to inquire about my order status. Order ID: ' + code;
      return 'https://wa.me/' + WA_PHONE + '?text=' + encodeURIComponent(msg);
    }
    function waButtonHtml(code) {
      return '<a class="tr-wa-btn" target="_blank" rel="noopener noreferrer" href="' + esc(waUrl(code)) + '">' +
             '<i class="fab fa-whatsapp"></i> اسأل الفريق على الواتساب</a>';
    }
    function fmtDate(iso) {
      var d = window.dawerliDB;
      if (d && typeof d.formatDate === 'function') return d.formatDate(iso);
      try { return new Date(iso).toLocaleString('ar-LY'); } catch (e) { return String(iso || ''); }
    }
    function statusLabel(status) {
      var d = window.dawerliDB;
      var labels = (d && d.STATUS_LABELS) || {};
      return labels[status] || status || '';
    }
    function fmtMoney(n) {
      var d = window.dawerliDB;
      if (d && typeof d.formatMoney === 'function') return d.formatMoney(n);
      return (n == null || n === '') ? '—' : String(n) + ' د.ل';
    }
    // أرقام عربية (٠-٩) وفارسية (۰-۹) → لاتينية (لوحات المفاتيح العربية تكتبها هكذا)
    function latinDigits(s) {
      return String(s == null ? '' : s)
        .replace(/[٠-٩]/g, function (ch) { return String.fromCharCode(ch.charCodeAt(0) - 0x0660 + 48); })
        .replace(/[۰-۹]/g, function (ch) { return String.fromCharCode(ch.charCodeAt(0) - 0x06F0 + 48); });
    }
    // هاتف: إزالة غير الأرقام، وتحويل 218… إلى 09…
    function normalizePhone(s) {
      var out = latinDigits(s).replace(/\D/g, '');
      if (out.length === 12 && out.indexOf('218') === 0) out = '0' + out.slice(3);
      return out;
    }
    // رقم الطلب: أرقام لاتينية، بلا فراغات، أحرف كبيرة (نفس التطبيع الذي تجريه get_order_status)
    function normalizeCode(s) {
      return latinDigits(s).replace(/\s/g, '').toUpperCase();
    }
    var PHONE_RE = /^09[0-9]{8}$/;

    /* ── عناصر النتيجة الحية ──────────────────────────────────── */
    var resultEl   = document.getElementById('trackResult');
    var eventsWrap = document.getElementById('trackEvents');
    var eventsList = document.getElementById('trackEventsList');
    var lastUpdate = document.getElementById('trackLastUpdate');
    var tlHint     = document.getElementById('tlHint');
    var tlHintDefault = tlHint ? tlHint.textContent : '';
    var demoSel    = document.getElementById('demoSelector');
    var timelineEl = document.getElementById('orderTimeline');
    var liveOrder  = null; // آخر طلب معروض من قاعدة البيانات (لإعادة الرسم عند تغيير اللغة)
    var livePhone  = '';   // هاتف الزبون المتحقق منه لعرض السعر — في الذاكرة فقط، لا يُخزن
    var quoteFlash = null; // رسالة تُعرض مرة واحدة داخل صندوق عرض السعر بعد إعادة التحميل

    function setTrackBusy(busy) {
      var btn = document.getElementById('trackBtn');
      if (!btn) return;
      btn.disabled = busy;
      if (busy) {
        btn.dataset.html = btn.innerHTML;
        btn.innerHTML = '<i class="fas fa-spinner fa-spin"></i> ثواني…';
      } else if (btn.dataset.html) {
        btn.innerHTML = btn.dataset.html;
        delete btn.dataset.html;
      }
    }
    function showSkeleton() {
      if (!resultEl) return;
      resultEl.classList.remove('is-error');
      resultEl.innerHTML = '<div class="tr-skeleton"><span></span><span></span><span></span></div>';
      resultEl.hidden = false;
    }
    // يرجّع الخط الزمني لوضع المعاينة (بدون بيانات حية)
    function resetTimeline() {
      if (demoSel) demoSel.hidden = false;
      if (timelineEl) timelineEl.hidden = false;
      if (tlHint) tlHint.textContent = tlHintDefault;
      clearSublabel();
      applyTimeline(1);
    }
    function showNotFound(code, customMsg) {
      if (!resultEl) return;
      var hadLive = !!liveOrder;
      liveOrder = null; livePhone = ''; quoteFlash = null;
      resultEl.classList.add('is-error');
      resultEl.innerHTML =
        '<p class="tr-error-msg"><i class="fas fa-search-minus"></i><span>' +
        esc(customMsg || 'ما لقيناش طلب بهذا الرقم — تأكد منه أو اسألنا على الواتساب') +
        '</span></p>' + waButtonHtml(code);
      resultEl.hidden = false;
      if (eventsWrap) eventsWrap.hidden = true;
      if (hadLive) resetTimeline();
    }
    function clearSublabel() {
      document.querySelectorAll('.tl-sublabel').forEach(function (el) { el.parentNode.removeChild(el); });
    }
    // يعرض status_label القادم من القاعدة تحت عنوان المرحلة الجارية (يفرّق "الشراء" عن "في الطريق" مثلاً)
    function setSublabel(stage, text) {
      clearSublabel();
      if (!text) return;
      var body = document.querySelector('.tl-item[data-stage-idx="' + stage + '"] .tl-body');
      if (!body) return;
      var el = document.createElement('div');
      el.className = 'tl-sublabel';
      el.innerHTML = '<i class="fas fa-location-arrow"></i> ';
      el.appendChild(document.createTextNode(text)); // نص من القاعدة → عقدة نصية (آمن)
      var title = body.querySelector('.tl-title');
      if (title && title.nextSibling) body.insertBefore(el, title.nextSibling); else body.appendChild(el);
    }

    /* صندوق عرض السعر: هاتف للتحقق → الأسعار → موافق / مش موافق */
    function quoteBoxHtml(order) {
      var h = '<div class="tr-quote" id="trQuote"><div class="tr-quote-title"><i class="fas fa-file-invoice-dollar"></i> عرض السعر</div>';
      if (order.verified) {
        h += '<dl class="tr-prices">' +
          '<div><dt>سعر الطلب</dt><dd>' + esc(fmtMoney(order.quoted_price)) + '</dd></div>' +
          '<div><dt>رسوم الخدمة</dt><dd>' + esc(fmtMoney(order.service_fee)) + '</dd></div>' +
          '<div class="tr-total"><dt>الإجمالي</dt><dd>' + esc(fmtMoney(order.total)) + '</dd></div>' +
        '</dl>';
        if (order.quote_response === 'accepted') {
          h += '<p class="tr-quote-hint"><i class="fas fa-check-circle" style="color:#4ade80"></i> وافقت على العرض ✓ — فريقنا يكمّل الشراء ويكلمك على الواتساب.</p>';
        } else if (order.quote_response === 'rejected') {
          h += '<p class="tr-quote-hint"><i class="fas fa-info-circle"></i> سجّلنا إنك مش موافق على العرض. كان تبي تعيد النظر أو تعدّل الطلب، كلمنا على الواتساب.</p>';
        } else {
          h += '<p class="tr-quote-hint">موافق على السعر؟ قولنا باش نكمّلوا الشراء.</p>' +
            '<div class="tr-quote-actions">' +
              '<button type="button" class="tr-btn tr-btn-accept" data-quote="accept"><i class="fas fa-check"></i> موافق — كمّلوا</button>' +
              '<button type="button" class="tr-btn tr-btn-reject" data-quote="reject"><i class="fas fa-times"></i> مش موافق</button>' +
            '</div>';
        }
      } else {
        h += '<p class="tr-quote-hint">حط رقمك اللي طلبت بيه باش تشوف السعر</p>' +
          '<div class="tr-quote-row">' +
            '<input type="tel" id="trQuotePhone" class="tr-quote-input" inputmode="numeric" maxlength="14" autocomplete="tel-national" placeholder="09XXXXXXXX" aria-label="رقم الهاتف اللي طلبت بيه">' +
            '<button type="button" class="tr-btn tr-btn-accept" id="trQuoteCheck"><i class="fas fa-eye"></i> شوف السعر</button>' +
          '</div>';
      }
      var flash = quoteFlash; quoteFlash = null;
      h += '<div class="tr-quote-msg' + (flash ? (flash.ok ? ' ok' : ' err') : '') + '" id="trQuoteMsg" role="status"' + (flash ? '' : ' hidden') + '>' + (flash ? esc(flash.text) : '') + '</div>';
      return h + '</div>';
    }
    function bindQuoteBox(order) {
      var box = document.getElementById('trQuote');
      if (!box) return;
      var msgEl = document.getElementById('trQuoteMsg');
      function say(text, ok) {
        if (!msgEl) return;
        msgEl.textContent = text;
        msgEl.classList.toggle('ok', !!ok);
        msgEl.classList.toggle('err', !ok);
        msgEl.hidden = false;
      }
      function busy(btns, on) { btns.forEach(function (b) { b.disabled = on; }); }

      /* التحقق بالهاتف */
      var checkBtn = document.getElementById('trQuoteCheck');
      var phoneIn  = document.getElementById('trQuotePhone');
      if (checkBtn && phoneIn) {
        var check = async function () {
          var phone = normalizePhone(phoneIn.value);
          if (!PHONE_RE.test(phone)) {
            say('رقم الهاتف لازم يكون ليبي صحيح — 10 أرقام ويبدا بـ 09.');
            phoneIn.focus();
            return;
          }
          var db = dbApi();
          if (!db) return;
          busy([checkBtn], true);
          try {
            var fresh = await db.getOrderStatus(order.code, phone);
            if (!fresh) { showNotFound(order.code); return; }
            if (!fresh.verified) { say('الرقم ما يطابقش الرقم اللي طلبت بيه — تأكد منه أو كلمنا على الواتساب.'); return; }
            livePhone = phone;
            renderOrder(fresh);
          } catch (err) {
            say(db.friendlyError(err));
          } finally {
            busy([checkBtn], false);
          }
        };
        checkBtn.addEventListener('click', check);
        phoneIn.addEventListener('keydown', function (e) { if (e.key === 'Enter') { e.preventDefault(); check(); } });
        phoneIn.addEventListener('input', function () { if (msgEl) msgEl.hidden = true; });
      }

      /* الرد على العرض */
      var actionBtns = Array.prototype.slice.call(box.querySelectorAll('[data-quote]'));
      actionBtns.forEach(function (btn) {
        btn.addEventListener('click', async function () {
          var accept = btn.getAttribute('data-quote') === 'accept';
          var db = dbApi();
          if (!db || !livePhone) return;
          busy(actionBtns, true);
          try {
            var ok = await db.respondToQuote(order.code, livePhone, accept);
            quoteFlash = ok
              ? { ok: true, text: accept ? 'تم ✓ وصلنا ردك — فريقنا يكمّل الشراء ويكلمك على الواتساب.' : 'تم — سجّلنا إنك مش موافق. كان تبي تعدّل الطلب كلمنا على الواتساب.' }
              : { ok: false, text: 'ما قدرناش نسجّل ردك — يمكن حالة الطلب اتغيّرت. جرّب تاني أو كلمنا على الواتساب.' };
            await refreshOrder(order.code, livePhone);
          } catch (err) {
            say(db.friendlyError(err));
            busy(actionBtns, false);
          }
        });
      });
    }
    async function refreshOrder(code, phone) {
      var db = dbApi();
      if (!db) return;
      try {
        var fresh = await db.getOrderStatus(code, phone || '');
        if (fresh) renderOrder(fresh); else showNotFound(code);
      } catch (err) {
        showNotFound(code, db.friendlyError(err));
      }
    }

    /* سجل التحديثات: status → status_label، note → نص الملاحظة */
    function eventsHtml(events) {
      return events.slice().reverse().map(function (ev) {
        var isNote = ev.kind === 'note';
        var cls = 'ev-item' + (isNote ? ' ev-note-item' : ev.status === 'cancelled' ? ' ev-cancelled' : ev.status === 'delivered' ? ' ev-delivered' : '');
        var body;
        if (isNote) {
          body = '<div class="ev-note ev-note-main">' + esc(ev.note || '') + ' <span class="ev-kind">ملاحظة من الفريق</span></div>';
        } else {
          body = '<div class="ev-status">' + esc(ev.status_label || statusLabel(ev.status)) + '</div>' +
                 (ev.note ? '<div class="ev-note">' + esc(ev.note) + '</div>' : '');
        }
        body += '<span class="ev-time">' + esc(fmtDate(ev.at)) + '</span>';
        return '<li class="' + cls + '"><span class="ev-dot"></span><div class="ev-body">' + body + '</div></li>';
      }).join('');
    }

    function renderOrder(order) {
      liveOrder = order;
      var cancelled = order.status === 'cancelled' || parseInt(order.stage_idx, 10) === -1;
      var delivered = order.status === 'delivered';
      var label  = order.status_label || statusLabel(order.status);
      var lastAt = order.status_changed_at || order.updated_at || order.created_at;
      var qty    = parseInt(order.quantity, 10);

      /* بطاقة الملخص */
      var statusCls = 'tr-status' + (cancelled ? ' st-cancelled' : delivered ? ' st-delivered' : '');
      var icon = cancelled ? 'fa-times-circle' : delivered ? 'fa-check-circle' : 'fa-circle-notch';
      var lastLabel = cancelled ? 'تاريخ الإلغاء' : delivered ? 'تاريخ التسليم' : 'آخر تحديث';
      var lastVal   = cancelled ? (order.cancelled_at || lastAt) : delivered ? (order.delivered_at || lastAt) : lastAt;
      var html =
        '<div class="tr-head">' +
          '<span class="tr-code">' + esc(order.code) + '</span>' +
          '<span class="' + statusCls + '"><i class="fas ' + icon + '"></i> ' + esc(label) + '</span>' +
        '</div>' +
        '<dl class="tr-meta">' +
          '<div><dt>مدينة التسليم</dt><dd>' + esc(order.city || '—') + '</dd></div>' +
          '<div><dt>نوع الطلب</dt><dd>' + esc(order.category || '—') + (qty > 1 ? ' <span class="tr-qty">× ' + esc(qty) + '</span>' : '') + '</dd></div>' +
          '<div><dt>تاريخ الطلب</dt><dd class="ev-time">' + esc(fmtDate(order.created_at)) + '</dd></div>' +
          '<div><dt>' + lastLabel + '</dt><dd class="ev-time">' + esc(fmtDate(lastVal)) + '</dd></div>' +
        '</dl>';
      if (cancelled) {
        // بطاقة إلغاء مخصصة — ما نمثّلوش مرحلة وهمية على الخط الزمني
        html += '<div class="tr-cancel-card">' +
          '<div class="tr-cancel-title"><i class="fas fa-ban"></i> هذا الطلب ملغي</div>' +
          (order.cancel_reason ? '<div class="tr-cancel-reason"><span>السبب:</span> ' + esc(order.cancel_reason) + '</div>' : '') +
          '<p>كان عندك استفسار أو تبي تعيد الطلب، كلمنا على الواتساب أو <a href="/request/">اطلب من جديد</a>.</p>' +
        '</div>';
      } else if (order.status === 'quoted') {
        html += quoteBoxHtml(order);
      }
      html += waButtonHtml(order.code);
      quoteFlash = null; // استُهلكت داخل صندوق العرض إن وُجد — لا تتسرب لعرض لاحق إن تغيّرت الحالة أثناء الرد
      resultEl.classList.remove('is-error');
      resultEl.innerHTML = html;
      resultEl.hidden = false;
      if (!cancelled && order.status === 'quoted') bindQuoteBox(order);

      /* الخط الزمني: إخفاء أزرار المعاينة التجريبية وتطبيق المرحلة الحقيقية */
      if (demoSel) demoSel.hidden = true;
      if (cancelled) {
        if (timelineEl) timelineEl.hidden = true;
        clearSublabel();
        if (tlHint) tlHint.textContent = 'الطلب ' + order.code + ' ملغي — ما فيش مراحل جارية.';
      } else {
        if (timelineEl) timelineEl.hidden = false;
        var stage = Math.max(0, Math.min(TOTAL_STAGES - 1, parseInt(order.stage_idx, 10) || 0));
        if (tlHint) tlHint.textContent = 'حالة طلبك ' + order.code + ' — تتحدّث تلقائياً مع كل خطوة';
        applyTimeline(stage);
        setSublabel(stage, label);
      }

      /* سجل التحديثات */
      var events = Array.isArray(order.events) ? order.events : [];
      if (eventsWrap && eventsList) {
        eventsList.innerHTML = events.length
          ? eventsHtml(events)
          : '<li class="ev-item"><span class="ev-dot"></span><div class="ev-body"><div class="ev-note">ما فيش تحديثات لسا — أول ما يتحرك طلبك تشوفه هني.</div></div></li>';
        if (lastUpdate) lastUpdate.textContent = 'آخر تحديث: ' + fmtDate(lastAt);
        eventsWrap.hidden = false;
      }
    }

    /* ── الاستعلام: قاعدة البيانات إن كانت مهيأة، وإلا واتساب ── */
    var tracking = false;
    async function doTrack() {
      var input = document.getElementById('trackInput');
      var errorEl = document.getElementById('trackError');
      var errorMsg = document.getElementById('trackErrorMsg');
      var val = normalizeCode(input.value);
      if (!val || !ORDER_REGEX.test(val)) {
        input.classList.add('error');
        errorMsg.textContent = getStr('trackInvalidId', 'رقم الطلب مش صحيح — الصيغة: DW-YYYY-XXXX');
        errorEl.classList.add('visible');
        input.focus();
        return;
      }
      input.classList.remove('error');
      errorEl.classList.remove('visible');

      var db = dbApi();
      if (!db) {
        // غير مهيأ: السلوك القديم — افتح واتساب
        window.open(waUrl(val), '_blank');
        return;
      }
      if (tracking) return;
      tracking = true;
      setTrackBusy(true);
      showSkeleton();
      // نعيد استعمال الهاتف المتحقق منه فقط لنفس الطلب
      if (!(liveOrder && liveOrder.code === val)) livePhone = '';
      try {
        var order = await db.getOrderStatus(val, livePhone || '');
        if (order) renderOrder(order);
        else showNotFound(val);
      } catch (err) {
        showNotFound(val, db.friendlyError(err));
      } finally {
        tracking = false;
        setTrackBusy(false);
      }
    }

    /* ══════════════════════════════════════════════════════════
       TIMELINE ENGINE (TASK 14-A)
       activeStage: 0–4  (0=received … 4=delivered)
       Each stage item gets class: done / active / pending
       The progress spine height is calculated from stages.
    ══════════════════════════════════════════════════════════ */
    var TOTAL_STAGES = 5;
    var activeStage = 1; // default mock: "Searching"

    function applyTimeline(stage) {
      activeStage = stage;
      var items = document.querySelectorAll('.tl-item');
      var spine = document.getElementById('tlSpine');
      var lang = getLang();

      items.forEach(function(item, idx) {
        var stageState = idx < stage ? 'done' : idx === stage ? 'active' : 'pending';
        item.classList.remove('done', 'active', 'pending');
        item.classList.add(stageState);

        /* Update badge text */
        var badge = item.querySelector('.tl-badge');
        if (badge) {
          badge.textContent = badge.getAttribute('data-badge-' + stageState) || '';
        }

        /* Update AR/EN text */
        var titleSpan = item.querySelector('.tl-title [data-tl-ar]');
        if (titleSpan) {
          titleSpan.textContent = lang === 'en'
            ? titleSpan.getAttribute('data-tl-en')
            : titleSpan.getAttribute('data-tl-ar');
        }
        var descP = item.querySelector('.tl-desc[data-tl-ar]');
        if (descP) {
          descP.textContent = lang === 'en'
            ? descP.getAttribute('data-tl-en')
            : descP.getAttribute('data-tl-ar');
        }
      });

      /* Animate spine height: covers from top of stage-0 to bottom of last completed stage */
      if (spine) {
        if (stage === 0) {
          spine.style.height = '0px';
        } else {
          /* Each stage row is approx equal height — use % of total steps */
          var pct = (stage / (TOTAL_STAGES - 1)) * 100;
          /* Cap between 0 and 100 */
          pct = Math.min(100, Math.max(0, pct));
          /* Convert to actual pixel height based on spine container */
          var timelineEl = document.getElementById('orderTimeline');
          if (timelineEl) {
            var totalH = timelineEl.offsetHeight - 56; /* subtract icon radius */
            spine.style.height = Math.round((pct / 100) * totalH) + 'px';
          }
        }
      }

      /* Update demo selector buttons */
      document.querySelectorAll('.demo-btn').forEach(function(btn) {
        btn.classList.toggle('active', parseInt(btn.getAttribute('data-stage')) === stage);
      });
    }

    /* ── Init ─────────────────────────────────────────────────── */
    document.addEventListener('DOMContentLoaded', function () {
      /* WhatsApp form */
      var btn  = document.getElementById('trackBtn');
      var input = document.getElementById('trackInput');
      var errorEl = document.getElementById('trackError');
      if (btn)   btn.addEventListener('click', doTrack);
      if (input) {
        input.addEventListener('keydown', function(e) { if (e.key === 'Enter') doTrack(); });
        input.addEventListener('input', function() {
          input.classList.remove('error');
          if (errorEl) errorEl.classList.remove('visible');
          var pos = input.selectionStart;
          input.value = normalizeCode(input.value);
          try { input.setSelectionRange(pos, pos); } catch(e) {}
        });
      }
      /* عند التهيئة: الزر الأساسي يستعلم من القاعدة بدل فتح واتساب */
      var live = !!dbApi();
      if (live && btn) {
        var icon = btn.querySelector('i');
        var label = btn.querySelector('[data-i18n]');
        if (icon) icon.className = 'fas fa-search';
        if (label) {
          label.setAttribute('data-i18n', 'trackBtn');
          label.textContent = getStr('trackBtn', 'تتبع');
        }
      }

      /* Pre-fill from URL param */
      var idParam = null;
      try {
        var params = new URLSearchParams(window.location.search);
        idParam = params.get('id') || params.get('order');
        if (idParam && input) input.value = normalizeCode(idParam);
        /* Allow URL param ?stage=N for Firebase integration later */
        var stageParam = params.get('stage');
        if (stageParam !== null) {
          var s = parseInt(stageParam);
          if (!isNaN(s) && s >= 0 && s < TOTAL_STAGES) activeStage = s;
        }
      } catch(e) {}

      /* Demo selector buttons */
      document.querySelectorAll('.demo-btn').forEach(function(dBtn) {
        dBtn.addEventListener('click', function() {
          applyTimeline(parseInt(dBtn.getAttribute('data-stage')));
        });
      });

      /* Re-apply on lang change */
      document.addEventListener('dawerli:langChanged', function() {
        if (liveOrder) { renderOrder(liveOrder); return; }
        applyTimeline(activeStage);
      });

      /* Initial render */
      applyTimeline(activeStage);

      /* استعلام تلقائي عند وجود ?id= والقاعدة مهيأة (لا نفتح واتساب تلقائياً أبداً) */
      if (live && idParam && input && ORDER_REGEX.test(input.value)) doTrack();
    });

  })();
  </script>

</Layout>
