---
// src/pages/track.astro
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="دورلي - وين طلبي؟"
  description="تتبع حالة طلبك في دورلي — حط رقم طلبك واستعلم عن مراحل معالجته."
  noindex={true}
>
  <script is:inline>document.documentElement.dataset.page = 'track';</script>

<style>
  /* ══════════════════════════════════════════════════════════════
     TRACK PAGE — TASK 14-A: Interactive Order Timeline
  ══════════════════════════════════════════════════════════════ */

  /* ── Hero ──────────────────────────────────────────────────── */
  .track-hero {
    padding: 5rem 1.5rem 3rem;
    text-align: center;
    background: radial-gradient(ellipse at 50% 0%, rgba(245,165,36,0.12) 0%, transparent 70%);
    border-bottom: 1px solid var(--glass-border);
  }
  .track-hero .badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(217,91,67,0.1);
    border: 1px solid rgba(217,91,67,0.25);
    color: var(--accent-light);
    border-radius: 50px;
    padding: 0.4rem 1rem;
    font-size: 0.82rem;
    font-weight: 700;
    margin-bottom: 1.2rem;
  }
  .track-hero h1 {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 900;
    color: var(--white);
    margin-bottom: 0.8rem;
    line-height: 1.2;
  }
  .track-hero p {
    color: var(--text-muted);
    font-size: 1rem;
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
  }

  /* ── Track Card ──────────────────────────────────────────── */
  .track-section {
    padding: 3rem 1.5rem 1.5rem;
    max-width: 640px;
    margin: 0 auto;
  }
  .track-card {
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius-lg);
    padding: 2.5rem;
    backdrop-filter: blur(8px);
  }
  .track-card label {
    display: block;
    font-size: 0.85rem;
    font-weight: 700;
    color: var(--text-muted);
    margin-bottom: 0.6rem;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .track-input-row {
    display: flex;
    gap: 0.75rem;
    align-items: stretch;
  }
  .track-input {
    flex: 1;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    color: var(--white);
    font-family: inherit;
    font-size: 1rem;
    font-weight: 600;
    padding: 0.85rem 1.1rem;
    outline: none;
    transition: var(--transition);
    direction: ltr;
    text-align: center;
    letter-spacing: 0.05em;
  }
  .track-input::placeholder { color: var(--text-muted); font-weight: 400; letter-spacing: 0; }
  .track-input:focus {
    border-color: var(--accent);
    background: rgba(217,91,67,0.05);
    box-shadow: 0 0 0 3px rgba(217,91,67,0.12);
  }
  .track-input.error {
    border-color: #ef4444;
    background: rgba(239,68,68,0.05);
  }
  .track-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: linear-gradient(135deg, #25D366, #128C7E);
    color: white;
    border: none;
    border-radius: var(--border-radius);
    padding: 0.85rem 1.5rem;
    font-family: inherit;
    font-size: 0.95rem;
    font-weight: 700;
    cursor: pointer;
    transition: var(--transition);
    white-space: nowrap;
    flex-shrink: 0;
  }
  .track-btn:hover { transform: translateY(-2px); box-shadow: 0 8px 20px rgba(37,211,102,0.3); }
  .track-btn:active { transform: translateY(0); }
  .track-error {
    display: none;
    align-items: center;
    gap: 0.5rem;
    color: #ef4444;
    font-size: 0.85rem;
    margin-top: 0.6rem;
    font-weight: 600;
  }
  .track-error.visible { display: flex; }
  .track-format-hint {
    text-align: center;
    color: var(--text-muted);
    font-size: 0.78rem;
    margin-top: 0.75rem;
  }
  .track-format-hint code {
    background: rgba(255,255,255,0.06);
    border: 1px solid var(--glass-border);
    border-radius: 6px;
    padding: 0.1rem 0.5rem;
    font-size: 0.8rem;
    color: var(--accent-light);
    font-family: monospace;
  }
  .track-notice {
    max-width: 640px;
    margin: 1.25rem auto 0;
    padding: 1rem 1.5rem;
    background: rgba(245,165,36,0.06);
    border: 1px solid rgba(245,165,36,0.2);
    border-radius: var(--border-radius);
    display: flex;
    align-items: flex-start;
    gap: 0.8rem;
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.6;
  }
  .track-notice i { color: var(--primary-light); margin-top: 0.15rem; flex-shrink: 0; }

  /* ══════════════════════════════════════════════════════════════
     VERTICAL TIMELINE — TASK 14-A
     5 stages: received → searching → quotation → transit → delivered
  ══════════════════════════════════════════════════════════════ */
  .timeline-wrapper {
    max-width: 640px;
    margin: 2.5rem auto 0;
    padding: 0 1.5rem 4rem;
  }
  .timeline-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .timeline-header h2 {
    font-size: 1.35rem;
    font-weight: 900;
    color: var(--white);
    margin-bottom: 0.4rem;
  }
  .timeline-header p {
    font-size: 0.85rem;
    color: var(--text-muted);
  }

  /* demo status selector */
  .demo-selector {
    display: flex;
    justify-content: center;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }
  .demo-btn {
    padding: 0.35rem 0.9rem;
    border-radius: 50px;
    border: 1px solid var(--glass-border);
    background: transparent;
    color: var(--text-muted);
    font-family: inherit;
    font-size: 0.78rem;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.2s, border-color 0.2s, color 0.2s;
  }
  .demo-btn:hover,
  .demo-btn.active {
    background: rgba(245,165,36,0.15);
    border-color: var(--primary);
    color: var(--white);
  }

  /* timeline container */
  .timeline {
    position: relative;
    padding: 0;
    list-style: none;
  }

  /* vertical spine */
  .timeline::before {
    content: '';
    position: absolute;
    top: 28px;
    bottom: 28px;
    right: 27px;            /* RTL: spine on the right */
    width: 2px;
    background: var(--glass-border);
    z-index: 0;
  }
  html[dir="ltr"] .timeline::before {
    right: auto;
    left: 27px;
  }

  /* filled spine overlay (progress) */
  .timeline-progress-spine {
    position: absolute;
    top: 28px;
    right: 27px;
    width: 2px;
    background: linear-gradient(to bottom, var(--primary), var(--accent));
    z-index: 1;
    transition: height 0.7s cubic-bezier(0.4,0,0.2,1);
    height: 0;
  }
  html[dir="ltr"] .timeline-progress-spine {
    right: auto;
    left: 27px;
  }

  /* each row */
  .tl-item {
    position: relative;
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    margin-bottom: 1.25rem;
    z-index: 2;
  }
  .tl-item:last-child { margin-bottom: 0; }

  /* icon bubble */
  .tl-icon {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    border: 2px solid var(--glass-border);
    background: var(--bg-surface);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.2rem;
    color: var(--text-muted);
    flex-shrink: 0;
    transition: border-color 0.4s, background 0.4s, color 0.4s, box-shadow 0.4s;
    position: relative;
    z-index: 3;
  }

  /* completed */
  .tl-item.done .tl-icon {
    border-color: #22c55e;
    background: rgba(34,197,94,0.12);
    color: #4ade80;
    box-shadow: 0 0 0 4px rgba(34,197,94,0.08);
  }
  /* active / in-progress */
  .tl-item.active .tl-icon {
    border-color: var(--accent);
    background: rgba(217,91,67,0.12);
    color: var(--accent-light);
    box-shadow: 0 0 0 6px rgba(217,91,67,0.1);
    animation: tl-pulse 2s ease-in-out infinite;
  }
  @keyframes tl-pulse {
    0%,100% { box-shadow: 0 0 0 6px rgba(217,91,67,0.1); }
    50%      { box-shadow: 0 0 0 10px rgba(217,91,67,0.04); }
  }

  /* body card */
  .tl-body {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    padding: 1rem 1.25rem;
    transition: border-color 0.4s, background 0.4s;
    margin-top: 0.3rem;
  }
  .tl-item.done .tl-body {
    border-color: rgba(34,197,94,0.2);
    background: rgba(34,197,94,0.04);
  }
  .tl-item.active .tl-body {
    border-color: rgba(217,91,67,0.3);
    background: rgba(217,91,67,0.06);
  }
  .tl-title {
    font-size: 0.95rem;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 0.3rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .tl-item.done .tl-title  { color: #4ade80; }
  .tl-item.active .tl-title { color: var(--accent-light); }
  .tl-item.pending .tl-title { color: var(--text-muted); }

  .tl-badge {
    font-size: 0.68rem;
    font-weight: 700;
    padding: 0.15rem 0.55rem;
    border-radius: 50px;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    flex-shrink: 0;
  }
  .tl-item.done   .tl-badge { background: rgba(34,197,94,0.15); color: #4ade80; }
  .tl-item.active .tl-badge { background: rgba(217,91,67,0.15); color: var(--accent-light); }
  .tl-item.pending .tl-badge { background: rgba(255,255,255,0.05); color: var(--text-muted); }

  .tl-desc {
    font-size: 0.82rem;
    color: var(--text-muted);
    line-height: 1.55;
  }
  .tl-item.done   .tl-desc { color: rgba(74,222,128,0.7); }
  .tl-item.active .tl-desc { color: rgba(245,165,36,0.8); }

  /* estimated time chip */
  .tl-time {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-muted);
    margin-top: 0.4rem;
    background: rgba(255,255,255,0.04);
    border: 1px solid var(--glass-border);
    border-radius: 50px;
    padding: 0.15rem 0.6rem;
  }
  .tl-item.active .tl-time {
    color: var(--accent-light);
    background: rgba(217,91,67,0.06);
    border-color: rgba(217,91,67,0.2);
  }

  /* ══════════════════════════════════════════════════════════════
     LIVE RESULT (Supabase) — بطاقة النتيجة + سجل التحديثات
  ══════════════════════════════════════════════════════════════ */
  .track-btn:disabled { opacity: 0.7; cursor: wait; transform: none; box-shadow: none; }
  .track-result {
    margin-top: 1.25rem;
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: var(--border-radius);
    padding: 1.25rem 1.4rem;
    animation: trFade 0.3s ease;
  }
  @keyframes trFade { from { opacity: 0; transform: translateY(-4px); } to { opacity: 1; transform: none; } }
  .track-result[hidden] { display: none; }
  .track-result.is-error { border-color: rgba(239,68,68,0.35); background: rgba(239,68,68,0.06); }
  .tr-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    flex-wrap: wrap;
    margin-bottom: 0.75rem;
  }
  .tr-code {
    font-family: 'Space Grotesk', monospace;
    direction: ltr;
    unicode-bidi: isolate;
    font-weight: 700;
    font-size: 1.05rem;
    color: var(--white);
    letter-spacing: 0.05em;
  }
  .tr-status {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.25rem 0.75rem;
    border-radius: 50px;
    font-size: 0.8rem;
    font-weight: 800;
    background: rgba(245,165,36,0.15);
    color: var(--primary-light);
    border: 1px solid rgba(245,165,36,0.3);
  }
  .tr-status.st-delivered { background: rgba(34,197,94,0.15); color: #4ade80; border-color: rgba(34,197,94,0.3); }
  .tr-status.st-cancelled { background: rgba(239,68,68,0.15); color: #f87171; border-color: rgba(239,68,68,0.3); }
  .tr-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
    gap: 0.5rem 1rem;
    margin: 0;
    font-size: 0.85rem;
  }
  .tr-meta div { display: flex; flex-direction: column; gap: 0.1rem; }
  .tr-meta dt { color: var(--text-muted); font-size: 0.72rem; font-weight: 700; letter-spacing: 0.03em; }
  .tr-meta dd { margin: 0; color: var(--text-main); font-weight: 600; }
  .tr-qty { color: var(--text-muted); font-weight: 600; font-size: 0.8rem; }

  /* بطاقة الطلب الملغي (بدون مرحلة وهمية على الخط الزمني) */
  .tr-cancel-card {
    margin-top: 0.9rem;
    padding: 0.9rem 1rem;
    border-radius: 12px;
    background: rgba(239,68,68,0.08);
    border: 1px solid rgba(239,68,68,0.3);
    color: var(--text-main);
    font-size: 0.88rem;
    line-height: 1.7;
  }
  .tr-cancel-title { display: flex; align-items: center; gap: 0.4rem; font-weight: 800; color: #f87171; margin-bottom: 0.3rem; }
  .tr-cancel-reason { color: #fca5a5; margin-bottom: 0.3rem; overflow-wrap: anywhere; }
  .tr-cancel-reason span { color: var(--text-muted); font-weight: 700; }
  .tr-cancel-card p { margin: 0; color: var(--text-muted); }
  .tr-cancel-card a { color: var(--primary-light); text-decoration: underline; }

  /* صندوق عرض السعر (يظهر فقط عندما تكون الحالة quoted) */
  .tr-quote {
    margin-top: 1rem;
    padding: 1rem 1.1rem;
    border-radius: 12px;
    background: rgba(245,165,36,0.07);
    border: 1px solid rgba(245,165,36,0.3);
  }
  .tr-quote-title { display: flex; align-items: center; gap: 0.45rem; font-weight: 800; color: var(--primary-light); margin-bottom: 0.5rem; }
  .tr-quote-hint  { margin: 0 0 0.6rem; color: var(--text-main); font-size: 0.88rem; line-height: 1.6; }
  .tr-quote-row   { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tr-quote-input {
    flex: 1;
    min-width: 160px;
    direction: ltr;
    text-align: left;
    font-family: 'Space Grotesk', monospace;
    font-size: 1rem;
    padding: 0.65rem 0.9rem;
    border-radius: 10px;
    background: rgba(0,0,0,0.25);
    border: 1px solid var(--glass-border);
    color: var(--white);
    outline: none;
    transition: var(--transition);
  }
  .tr-quote-input:focus { border-color: var(--primary); box-shadow: 0 0 0 3px rgba(245,165,36,0.15); }
  .tr-prices { display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 0.5rem 1rem; margin: 0 0 0.8rem; }
  .tr-prices div { display: flex; flex-direction: column; gap: 0.1rem; }
  .tr-prices dt { font-size: 0.72rem; color: var(--text-muted); font-weight: 700; }
  .tr-prices dd { margin: 0; font-weight: 800; color: var(--white); font-size: 1rem; }
  .tr-prices .tr-total dd { color: var(--primary-light); font-size: 1.15rem; }
  .tr-quote-actions { display: flex; gap: 0.5rem; flex-wrap: wrap; }
  .tr-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.4rem;
    padding: 0.65rem 1rem;
    border-radius: 10px;
    border: 1px solid transparent;
    font-family: inherit;
    font-weight: 800;
    font-size: 0.9rem;
    cursor: pointer;
    transition: var(--transition);
  }
  .tr-btn:disabled { opacity: 0.6; cursor: wait; transform: none; }
  .tr-btn-accept { flex: 1; background: linear-gradient(135deg, var(--primary), var(--accent)); color: #14100B; }
  .tr-btn-accept:hover:not(:disabled) { transform: translateY(-1px); box-shadow: 0 6px 18px rgba(245,165,36,0.3); }
  .tr-btn-reject { background: rgba(255,255,255,0.05); border-color: var(--glass-border); color: var(--text-main); }
  .tr-btn-reject:hover:not(:disabled) { background: rgba(239,68,68,0.12); border-color: rgba(239,68,68,0.35); color: #fca5a5; }
  .tr-quote-msg {
    display: flex;
    align-items: flex-start;
    gap: 0.45rem;
    margin-top: 0.7rem;
    padding: 0.6rem 0.8rem;
    border-radius: 10px;
    font-size: 0.85rem;
    line-height: 1.6;
    background: rgba(255,255,255,0.05);
    border: 1px solid var(--glass-border);
    color: var(--text-main);
  }
  .tr-quote-msg.ok  { background: rgba(34,197,94,0.1);  border-color: rgba(34,197,94,0.3);  color: #4ade80; }
  .tr-quote-msg.err { background: rgba(239,68,68,0.1);  border-color: rgba(239,68,68,0.3);  color: #fca5a5; }
  .tr-quote-msg[hidden] { display: none; }
  .tr-error-msg {
    display: flex;
    align-items: flex-start;
    gap: 0.6rem;
    color: #fca5a5;
    font-size: 0.92rem;
    font-weight: 600;
    line-height: 1.6;
  }
  .tr-error-msg i { color: #f87171; margin-top: 0.15rem; }
  .tr-wa-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    margin-top: 1rem;
    width: 100%;
    padding: 0.75rem 1.1rem;
    border-radius: var(--border-radius);
    background: rgba(37,211,102,0.12);
    border: 1px solid rgba(37,211,102,0.4);
    color: #4ade80;
    font-weight: 700;
    font-size: 0.9rem;
    text-decoration: none;
    transition: var(--transition);
  }
  .tr-wa-btn:hover { background: rgba(37,211,102,0.2); transform: translateY(-1px); }
  .tr-skeleton { display: grid; gap: 0.6rem; }
  .tr-skeleton span {
    display: block;
    height: 14px;
    border-radius: 6px;
    background: linear-gradient(90deg, rgba(255,255,255,0.05), rgba(255,255,255,0.12), rgba(255,255,255,0.05));
    background-size: 200% 100%;
    animation: trShimmer 1.2s infinite;
  }
  .tr-skeleton span:nth-child(1) { width: 45%; height: 20px; }
  .tr-skeleton span:nth-child(3) { width: 70%; }
  @keyframes trShimmer { from { background-position: 200% 0; } to { background-position: -200% 0; } }

  /* عند عرض بيانات حية: نخفي أزرار المعاينة، وعند الإلغاء نخفي الخط الزمني كله */
  .demo-selector[hidden], .timeline[hidden] { display: none !important; }

  /* التسمية الفرعية للمرحلة الجارية (status_label من القاعدة — تفرّق الشراء عن الشحن مثلاً) */
  .tl-sublabel {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    margin: 0 0 0.4rem;
    padding: 0.15rem 0.6rem;
    border-radius: 50px;
    font-size: 0.78rem;
    font-weight: 700;
    color: var(--primary-light);
    background: rgba(245,165,36,0.1);
    border: 1px solid rgba(245,165,36,0.25);
  }

  /* سجل التحديثات تحت الخط الزمني */
  .track-events { margin-top: 2rem; }
  .track-events[hidden] { display: none; }
  .track-events h3 {
    font-size: 1rem;
    font-weight: 800;
    color: var(--white);
    margin-bottom: 0.8rem;
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }
  .track-events h3 i { color: var(--accent-light); }
  .ev-list { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.5rem; }
  .ev-item {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    padding: 0.75rem 1rem;
    background: var(--bg-card);
    border: 1px solid var(--glass-border);
    border-radius: 12px;
  }
  .ev-dot {
    width: 10px; height: 10px; border-radius: 50%;
    background: var(--primary);
    flex-shrink: 0;
    margin-top: 0.4rem;
    box-shadow: 0 0 0 3px rgba(245,165,36,0.15);
  }
  .ev-item.ev-cancelled .ev-dot { background: #ef4444; box-shadow: 0 0 0 3px rgba(239,68,68,0.15); }
  .ev-item.ev-delivered .ev-dot { background: #22c55e; box-shadow: 0 0 0 3px rgba(34,197,94,0.15); }
  .ev-item.ev-note-item .ev-dot { background: var(--accent-light); box-shadow: 0 0 0 3px rgba(217,91,67,0.15); }
  .ev-body { flex: 1; min-width: 0; }
  .ev-status { font-weight: 800; color: var(--white); font-size: 0.9rem; }
  .ev-kind { font-size: 0.68rem; font-weight: 700; color: var(--text-muted); background: rgba(255,255,255,0.05); border-radius: 50px; padding: 0.1rem 0.5rem; margin-inline-start: 0.4rem; vertical-align: middle; }
  .ev-note { color: var(--text-main); font-size: 0.85rem; line-height: 1.6; margin-top: 0.2rem; overflow-wrap: anywhere; }
  .ev-note-main { font-size: 0.9rem; margin-top: 0; }
  /* التاريخ يأتي بصيغة ar-LY (أرقام لاتينية داخل نص عربي) — plaintext يحدد الاتجاه من أول حرف قوي بدل فرض LTR يقلب ترتيب الكلمات */
  .ev-time { color: var(--text-muted); font-size: 0.75rem; margin-top: 0.25rem; unicode-bidi: plaintext; display: inline-block; }
  .ev-last { color: var(--text-muted); font-size: 0.8rem; margin-top: 0.8rem; text-align: center; }

  /* responsive */
  @media (max-width: 600px) {
    .track-input-row { flex-direction: column; }
    .track-btn { justify-content: center; }
    .track-card { padding: 1.5rem; }
    .track-result { padding: 1rem 1.1rem; }
    .timeline::before,
    .timeline-progress-spine { right: 23px; }
    html[dir="ltr"] .timeline::before,
    html[dir="ltr"] .timeline-progress-spine { right: auto; left: 23px; }
    .tl-icon { width: 48px; height: 48px; font-size: 1rem; }
  }
</style>

