---
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/700.css';
import '@fontsource/rubik/900.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import FuturisticHero from '../components/lab/FuturisticHero.tsx';
---

<!doctype html>
<html lang="ar" dir="rtl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="theme-color" content="#08080C" />
    <title>دورلي · القفزة — نموذج أولي</title>
    <style is:global>
      :root {
        --bg: #08080c;
        --bg2: #0a0a0f;
        --panel: rgba(255, 255, 255, 0.05);
        --border: rgba(255, 255, 255, 0.09);
        --text: #eaeaf2;
        --muted: #9aa0b5;
        --cyan: #22d3ee;
        --violet: #7c3aed;
        --lime: #a3e635;
        --font-ar: 'Rubik', 'Tajawal', system-ui, -apple-system, sans-serif;
        --font-dsp: 'Space Grotesk', 'Rubik', system-ui, sans-serif;
      }
      * { box-sizing: border-box; margin: 0; padding: 0; }
      html, body { background: var(--bg); color: var(--text); font-family: var(--font-ar); }
      body { overflow-x: hidden; -webkit-font-smoothing: antialiased; }
      a { color: inherit; text-decoration: none; }
      ::selection { background: rgba(34, 211, 238, 0.3); }
      @media (pointer: fine) { .hero-root { cursor: none; } }
    </style>
  </head>
  <body>
    <FuturisticHero client:load />
  </body>
</html>
