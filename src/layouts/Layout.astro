---
// src/layouts/Layout.astro
interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
}

const { title, description = "منصة دورلي - تدوّر على حاجة؟ دورلي يجيبهالكه في ليبيا." , noindex = false } = Astro.props;
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

// Self-hosted fonts via @fontsource (replaces render-blocking Google Fonts CDN).
// Tajawal has no 600 weight — using its real weights 400/500/700/900.
import '@fontsource/tajawal/400.css';
import '@fontsource/tajawal/500.css';
import '@fontsource/tajawal/700.css';
import '@fontsource/tajawal/900.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/600.css';
import '@fontsource/inter/700.css';
// "القفزة" identity fonts — Rubik (Arabic display+body) + Space Grotesk (Latin display).
import '@fontsource/rubik/400.css';
import '@fontsource/rubik/500.css';
import '@fontsource/rubik/700.css';
import '@fontsource/rubik/900.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
